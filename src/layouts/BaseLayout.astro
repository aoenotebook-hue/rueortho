---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import defaultShareImage from '../assets/hero-shoulder-pain.png';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import GoogleTagManagerNoscript from '../components/GoogleTagManagerNoscript.astro';
import { t, type Locale } from '../i18n/ui';
import { site } from '../data/site';
import { getLocaleFromUrl, getAlternatePath, localizePath, stripLocale } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  /** Omit on pages that exist in one language only. */
  hasAlternate?: boolean;
  ogType?: 'website' | 'article';
  /** Keep the page out of search engines. Set on every draft article. */
  noindex?: boolean;
  /**
   * The picture a link to this page shows when it is shared. Articles pass
   * their own `heroImage`; everything else falls back to the site's.
   */
  image?: ImageMetadata;
}

const {
  title,
  description,
  hasAlternate = true,
  ogType = 'website',
  noindex = false,
  image,
} = Astro.props;

const locale: Locale = getLocaleFromUrl(Astro.url);
const tr = t(locale);
const alternate = getAlternatePath(Astro.url);

const siteName = tr('site.name');
const pageTitle = `${title} | ${siteName}`;
const pageDescription = description ?? tr('site.description');

/**
 * Every absolute URL on the page is built from `Astro.site` — the origin in
 * `src/data/site.ts` — never from the request, so a page served from a preview
 * domain, a proxy or a forged Host header still names the production address.
 *
 * The path is normalised through the locale helpers rather than taken from
 * `Astro.url.pathname`, so canonical, alternates and the feeds agree on one
 * spelling of a page: no trailing slash, and the language prefix applied once.
 */
const shared = stripLocale(Astro.url.pathname);
const canonical = new URL(localizePath(shared, locale), Astro.site).href;
const alternateUrl = new URL(alternate.path, Astro.site).href;
const thaiUrl = new URL(localizePath(shared, 'th'), Astro.site).href;

/**
 * The share picture.
 *
 * Every page carried `twitter:card="summary_large_image"` and no image at all,
 * so a link posted to LINE, Facebook or X rendered as a blank card — on a site
 * whose readers reach it by being sent a link, that is most of the first
 * impression. An article uses its own illustration and everything else the
 * site's hero; both are the author's own drawings, so nothing new is licensed.
 *
 * JPEG rather than WebP: this file is fetched by the crawlers behind those
 * platforms, not by a browser, and their WebP support is uneven. 1200px is the
 * width they all ask for. The URL has to be absolute, and is built from
 * `Astro.site` for the same reason the canonical is.
 */
const shareSource = image ?? defaultShareImage;
const shareImage = await getImage({
  src: shareSource,
  width: 1200,
  format: 'jpg',
  quality: 80,
});
const shareImageUrl = new URL(shareImage.src, Astro.site).href;

/*
 * A large card is a promise about the picture's shape. The condition
 * illustrations come in two — 4:3 scenes and square badges — and a square one
 * in a 1.91:1 slot is cropped to a band across its middle, so those get the
 * small card, which shows a square thumbnail beside the text instead.
 */
const wideEnoughForLargeCard = shareImage.attributes.width / shareImage.attributes.height >= 1.5;
---

<!doctype html>
<html lang={locale === 'th' ? 'th' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Google Tag Manager, as high in the head as the charset and viewport
      declarations allow. It is a <script src> rather than Google's inline
      snippet because our CSP hashes only what Astro generates — see
      `public/gtm.js`.
    */}
    <GoogleTagManager />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {/* Google Search Console ownership. Site-wide, and claimed a second way by
        `public/googlef9618cb9fa32a0a8.html` — see `src/data/site.ts`. */}
    <meta name="google-site-verification" content={site.googleSiteVerification} />
    {/* Drafts are built only in dev and preview, and must never be indexed. */}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/*
      A page always points at itself in its own language: a cluster whose
      members do not name themselves is ignored, so the self link is not
      optional. The other two are only true when the page really does exist in
      both languages — `hasAlternate` is false for a page that has no
      counterpart, and advertising one would send a reader to a 404 and tell a
      crawler the same lie.
    */}
    <link rel="alternate" hreflang={locale} href={canonical} />
    {
      hasAlternate && (
        <>
          <link rel="alternate" hreflang={alternate.locale} href={alternateUrl} />
          {/* Thai is the default language of the site, so it takes x-default. */}
          <link rel="alternate" hreflang="x-default" href={thaiUrl} />
        </>
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale === 'th' ? 'th_TH' : 'en_US'} />
    {hasAlternate && (
      <meta property="og:locale:alternate" content={locale === 'th' ? 'en_US' : 'th_TH'} />
    )}
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content={String(shareImage.attributes.width)} />
    <meta property="og:image:height" content={String(shareImage.attributes.height)} />
    <meta property="og:image:alt" content={title} />
    <meta
      name="twitter:card"
      content={wideEnoughForLargeCard ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:image" content={shareImageUrl} />

    {/* The mark is raster, so there is no SVG favicon to prefer here. 32px for
        the tab, 192px for an Android home screen, and a flattened 180px for
        iOS, which composites a transparent icon onto black. */}
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta name="theme-color" content="#f7f8f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1518" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai+Looped:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
    />

    <Analytics />

    <slot name="head" />
  </head>

  <body>
    {/* Google's instructions put this immediately after the opening tag. It is
        hidden, carries no link and is inert with scripting on, so it does not
        come before the skip link in the tab order. */}
    <GoogleTagManagerNoscript />
    <a class="skip-link" href="#main">{tr('a11y.skipToContent')}</a>
    <Header
      locale={locale}
      alternateHref={hasAlternate ? undefined : localizePath('/', locale === 'th' ? 'en' : 'th')}
    />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
