---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import AuthorPage from '../../../../components/AuthorPage.astro';
import { authors, getAuthor } from '../../../../data/authors';

export async function getStaticPaths() {
  return Object.keys(authors).map((id) => ({ params: { id } }));
}

const locale = 'en' as const;
const { id } = Astro.params;
const author = getAuthor(id!);
---

<BaseLayout title={author.name[locale]} description={author.bio[locale][0]}>
  <AuthorPage locale={locale} authorId={id!} />
</BaseLayout>
