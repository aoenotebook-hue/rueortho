---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ResourceIndex from '../../../components/ResourceIndex.astro';
import { getSection } from '../../../data/sections';

const locale = 'en' as const;
const section = getSection('treatments');
---

<BaseLayout title={section.title[locale]} description={section.intro[locale]}>
  <ResourceIndex locale={locale} collection="treatments" />
</BaseLayout>
