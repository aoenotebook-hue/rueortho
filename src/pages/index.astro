---
import BaseLayout from '../layouts/BaseLayout.astro';
import Home from '../components/Home.astro';
import { t } from '../i18n/ui';

const locale = 'th' as const;
const tr = t(locale);
---

<BaseLayout title={tr('site.tagline')} description={tr('site.description')}>
  <Home locale={locale} />
</BaseLayout>
