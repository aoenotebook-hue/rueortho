---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticlesIndex from '../components/ArticlesIndex.astro';
import { getSection } from '../data/sections';

const locale = 'th' as const;
const section = getSection('articles');
---

<BaseLayout title={section.title[locale]} description={section.intro[locale]}>
  <ArticlesIndex locale={locale} />
</BaseLayout>
