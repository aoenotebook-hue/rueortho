---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionStub from '../components/SectionStub.astro';
import { getSection } from '../data/sections';

const locale = 'th' as const;
const section = getSection('treatments');
---

<BaseLayout title={section.title[locale]} description={section.intro[locale]}>
  <SectionStub locale={locale} sectionId="treatments" />
</BaseLayout>
