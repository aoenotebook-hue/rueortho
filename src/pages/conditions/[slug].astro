---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConditionArticle from '../../components/ConditionArticle.astro';
import { getConditions } from '../../lib/conditions';

export async function getStaticPaths() {
  const conditions = await getConditions('th');
  return conditions.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const locale = 'th' as const;
const { entry } = Astro.props;
---

<BaseLayout title={entry.data.title} description={entry.data.summary} ogType="article">
  <ConditionArticle locale={locale} entry={entry} />
</BaseLayout>
