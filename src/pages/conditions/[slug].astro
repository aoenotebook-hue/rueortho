---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConditionArticle from '../../components/ConditionArticle.astro';
import { getConditions } from '../../lib/conditions';

export async function getStaticPaths() {
  const [conditions, counterparts] = await Promise.all([
    getConditions('th'),
    getConditions('en'),
  ]);
  const translated = new Set(counterparts.map((entry) => entry.data.slug));

  return conditions.map((entry) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      // The counterpart page is advertised only when this build really
      // produced it: the file exists in the other language, it is not held
      // back as a draft, and the author has not marked the translation as
      // still pending. Anything else points `hreflang` at a 404.
      hasAlternate: !entry.data.translationPending && translated.has(entry.data.slug),
    },
  }));
}

const locale = 'th' as const;
const { entry, hasAlternate } = Astro.props;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  ogType="article"
  noindex={entry.data.draft}
  hasAlternate={hasAlternate}
>
  <ConditionArticle locale={locale} entry={entry} />
</BaseLayout>
