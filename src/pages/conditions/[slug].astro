---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/ui';
import { formatDate, isoDate } from '../../i18n/utils';
import { getConditions } from '../../lib/conditions';
import { getAuthor, byline } from '../../data/authors';

export async function getStaticPaths() {
  const conditions = await getConditions('th');
  return conditions.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const locale = 'th' as const;
const tr = t(locale);
const { entry } = Astro.props;
const { Content } = await render(entry);
const author = getAuthor(entry.data.author);
---

<BaseLayout title={entry.data.title} description={entry.data.summary} ogType="article">
  <article style="max-width: 68ch; margin: 0 auto; padding: 2rem 1.25rem;">
    <h1>{entry.data.title}</h1>
    <p>{entry.data.summary}</p>

    <p>
      <span>{byline(author, locale)}</span>
      <br />
      <span>
        {tr('article.lastReviewed')}
        <time datetime={isoDate(entry.data.lastReviewed)}>
          {formatDate(entry.data.lastReviewed, locale)}
        </time>
      </span>
    </p>

    <Content />

    {
      entry.data.sources.length > 0 && (
        <section>
          <h2>{tr('article.references')}</h2>
          <ol>
            {entry.data.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer">
                  {source.title}
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </article>
</BaseLayout>
