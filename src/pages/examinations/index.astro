---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceIndex from '../../components/ResourceIndex.astro';
import { getSection } from '../../data/sections';

const locale = 'th' as const;
const section = getSection('examinations');
---

<BaseLayout title={section.title[locale]} description={section.intro[locale]}>
  <ResourceIndex locale={locale} collection="examinations" />
</BaseLayout>
