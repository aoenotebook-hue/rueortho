---
import Container from './Container.astro';
import { t, type Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

/**
 * Pagefind indexes the built site, so the index only exists after
 * `npm run build`. In `npm run dev` there is nothing to query — say so plainly
 * rather than letting the page throw.
 */
const isDev = import.meta.env.DEV;

/** Where a reader goes when search cannot help: both real, both localised. */
const browse = [
  { href: localizePath('/conditions', locale), label: tr('search.browseAll') },
  { href: localizePath('/articles', locale), label: tr('search.browseArticles') },
];

// Handed to the client script so every visible string still comes from ui.ts.
const strings = {
  searching: tr('search.searching'),
  results: tr('search.results'),
  noResults: tr('search.noResults'),
  noResultsHint: tr('search.noResultsHint'),
  unavailable: tr('search.unavailable'),
  browse,
};
---

<Container width="prose">
  <div class="py-10">
    <h1>{tr('search.label')}</h1>
    <p class="text-muted">{tr('search.hint')}</p>

    {
      isDev ? (
        <p class="mt-6 rounded-[10px] border border-info-border bg-info-ground p-5 text-info-ink">
          {tr('search.devNotice')}
        </p>
      ) : (
        <>
          <form class="mt-6" role="search" data-search-form>
            <label class="visually-hidden" for="search-input">
              {tr('search.label')}
            </label>
            <input
              id="search-input"
              type="search"
              name="q"
              autocomplete="off"
              autofocus
              placeholder={tr('search.placeholder')}
              class="w-full rounded-[6px] border border-border bg-surface px-4 py-3 text-ink"
              data-search-input
            />
          </form>

          {/*
            Every state the search can be in — searching, a count, no results,
            unavailable — is written here, and `aria-atomic` makes a screen
            reader read the whole new sentence rather than the words that
            changed. The results themselves are a list below it, which is what
            a reader moves to next.
          */}
          <p class="mt-5 text-muted" role="status" aria-live="polite" aria-atomic="true" data-search-status />

          <ul class="m-0 mt-4 list-none p-0" data-search-results />

          {/*
            The box above cannot work without the script, so say so and offer
            the two lists that reach everything on the site. Rendered only when
            scripting is off; with it on the parser treats this as text.
          */}
          <noscript>
            <p class="mt-5 rounded-[10px] border border-info-border bg-info-ground p-5 text-info-ink">
              {tr('search.noScript')}
            </p>
            <ul class="m-0 mt-4 flex list-none flex-wrap gap-3 p-0">
              {browse.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="inline-block rounded-full border border-border bg-surface px-5 py-2.5 text-ink no-underline hover:border-accent"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </noscript>

          <script
            type="application/json"
            data-search-strings
            set:html={JSON.stringify(strings)}
            is:inline
          />
        </>
      )
    }
  </div>
</Container>

{/* Loaded from public/ so Vite never rewrites its dynamic import of Pagefind. */}
{!isDev && <script type="module" src="/search.js" is:inline />}
