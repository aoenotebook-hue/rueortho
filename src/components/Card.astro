---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import RegionArt from './RegionArt.astro';
import RegionBadge from './RegionBadge.astro';
import SectionIcon from './SectionIcon.astro';
import type { RegionId } from '../data/regions';
import type { ResourceCollection } from '../lib/resources';
import type { Locale } from '../i18n/ui';

interface Props {
  href: string;
  title: string;
  summary?: string;
  /**
   * A picture from inside this topic, shown as the card's icon.
   *
   * Asked for on 2026-09-19: the icon was the region's drawing, which is the
   * same picture on every knee article, and a collection glyph, which is the
   * same on every treatment. A condition lends its `heroImage`; a resource
   * article lends one frame chosen in `lib/topic-images.ts`. Without one the
   * card falls back to the region drawing, then to the collection glyph, so
   * nothing renders an empty box.
   */
  image?: ImageMetadata;
  region?: RegionId;
  /**
   * Which library the card belongs to, for the icon.
   *
   * A card with a `region` shows the author's own drawing for that region;
   * anything else falls back to this collection's glyph. A rehabilitation
   * article may carry a region and then gets the drawing, which is right — the
   * knee programme is about the knee.
   */
  collection?: ResourceCollection;
  /**
   * Show the region's name as a pill beside the title.
   *
   * `/regions/<id>` passes false: every card there is the same region, so the
   * pill would repeat the page's own `h1` on every row. The drawing still
   * shows, because an icon that names the body part is useful even when the
   * words beside it would not be.
   */
  badge?: boolean;
  /**
   * A quiet line under the summary saying where the link lands.
   *
   * The video gallery uses it, and it is the reason that gallery can be
   * ordinary cards at all: a clip's card links into the middle of an article,
   * at the `##` section that carries the exercise's cautions, and a card that
   * jumps a reader there without saying so is a card that lied. Nothing else
   * passes it — a listing whose rows all go to the obvious place does not need
   * a line repeating that.
   */
  meta?: string;
  /**
   * Let the summary run to its full length instead of clamping it.
   *
   * **The video gallery sets it, and for a safety reason rather than a visual
   * one.** Every other listing's summary is a `cardSummary` written to fit two
   * lines, so clamping one only ever hides a few words of description. A clip's
   * summary is the author's caption, written to sit under a playing video, and
   * several of them carry their caution in the last clause — "หยุดที่ความตึง
   * ไม่ใช่ที่ความปวด", "ดึงที่ต้นแขน ห้ามดึงที่ข้อมือ", "Stop at a stretch, not
   * at a sting". Measured at 390px, the clamp cut 30 of 38 captions, and what
   * it cut was the end: the clamp was deleting the warning and leaving the
   * instruction. A tall row is the cheap problem here.
   */
  fullSummary?: boolean;
  /**
   * Draw a play triangle over the icon.
   *
   * Only the video gallery sets it. The icon there is a frame cut from the
   * clip, which on its own looks like any other photograph — the badge is what
   * says the row is a clip, in shape rather than in colour, per the site's own
   * rule. It is decorative: the card's `meta` line and its heading carry the
   * same fact in words.
   */
  playBadge?: boolean;
  locale: Locale;
  /**
   * Heading level for the card title. Cards on the home page sit under a
   * section `h2`, so `h3` is right there and stays the default. On a listing
   * page the cards are the only thing under the `h1`, and an `h3` would skip a
   * level — those callers pass 2.
   */
  headingLevel?: 2 | 3 | 4;
}

const {
  href,
  title,
  summary,
  image,
  region,
  collection,
  badge = true,
  meta,
  fullSummary = false,
  playBadge = false,
  locale,
  headingLevel = 3,
} = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';

const hasIcon = image !== undefined || region !== undefined || collection !== undefined;
---

{/*
  A wide row, not a tile.

  These were square cards in an `auto-fill` grid, three or four to a line on a
  desktop, and the author asked on 2026-09-19 for one topic per row so nothing
  competes for the eye sideways. A row also gives the summary the full measure,
  which is what lets it stay on one or two lines instead of five.

  The icon is decorative and the title beside it carries the meaning, so
  neither `RegionArt` nor `SectionIcon` contributes an accessible name — see
  the `alt=""` and `aria-hidden` in each.
*/}
<a
  href={href}
  class="group flex items-start gap-4 rounded-[10px] border border-border bg-surface p-4 no-underline transition hover:border-accent hover:shadow-[var(--shadow-card)] sm:gap-5 sm:p-5"
>
  {
    hasIcon && (
      <span class:list={['card-icon', playBadge && 'card-icon-play']}>
        {image ? (
          /*
            One fixed size, not a `widths` set: the box is 68px at most, so a
            192px source covers a 2x screen and nothing larger is ever worth
            fetching. `widths` would also emit the untouched 1024px original
            as the `src`, which is a 200 KB file behind a 68px picture.
          */
          <Image
            src={image}
            alt=""
            width={192}
            height={144}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        ) : region ? (
          <RegionArt region={region} sizes="68px" class="rounded-[8px]" />
        ) : (
          <SectionIcon collection={collection!} size={34} />
        )}
        {playBadge && (
          <svg
            class="card-play"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M8 5v14l11-7z" />
          </svg>
        )}
      </span>
    )
  }

  {/*
    `min-w-0` is load-bearing on any flex child holding Thai: Thai has no
    spaces between words, so a title is one unbreakable token and a flex item's
    default `min-width: auto` would size this column to the whole of it and
    push the card past the viewport.
  */}
  <span class="min-w-0 flex-1">
    <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <Heading class="m-0 text-ink group-hover:text-accent">{title}</Heading>
      {region && badge && <RegionBadge region={region} locale={locale} />}
    </span>
    {/*
      Two lines from sm up, three on a phone. A desktop row is wide enough
      that a `cardSummary` lands on one line; a 390px card is a third of that
      measure, so the same sentence needs three. The clamp is the guard for an
      article that has no `cardSummary` and falls back to the long `summary`.
      Never add `block` beside it: Tailwind's `line-clamp` works by setting
      `display: -webkit-box`, and a `block` wins the cascade and silently
      turns the clamp off.
    */}
    {
      summary && (
        <p
          class:list={[
            'm-0 mt-1.5 text-[0.95em] text-muted',
            !fullSummary && 'line-clamp-3 sm:line-clamp-2',
          ]}
        >
          {summary}
        </p>
      )
    }
    {/*
      Where the link actually lands. One line, clamped, and below the summary
      rather than above it: the clip's own caption is what the reader is
      choosing between, and the article it sits in is the answer to "where does
      this take me", which is a second question.
    */}
    {meta && <p class="m-0 mt-1.5 line-clamp-2 text-[0.85em] text-muted">{meta}</p>}
  </span>
</a>
