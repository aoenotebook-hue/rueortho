---
import RegionBadge from './RegionBadge.astro';
import type { RegionId } from '../data/regions';
import type { Locale } from '../i18n/ui';

interface Props {
  href: string;
  title: string;
  summary?: string;
  region?: RegionId;
  locale: Locale;
}

const { href, title, summary, region, locale } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-[10px] border border-border bg-surface p-5 no-underline transition hover:border-accent hover:shadow-[var(--shadow-card)]"
>
  {region && <div class="mb-3"><RegionBadge region={region} locale={locale} /></div>}
  <h3 class="mb-2 text-ink group-hover:text-accent">{title}</h3>
  {summary && <p class="m-0 text-[0.95em] text-muted">{summary}</p>}
</a>
