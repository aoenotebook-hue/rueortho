---
interface Props {
  size?: number;
}

const { size = 34 } = Astro.props;
---

{/* A figure in motion — the site is about getting movement back. Decorative;
    the wordmark beside it carries the name. */}
<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class="shrink-0"
>
  <circle cx="27" cy="8" r="4" fill="var(--brand)" />
  <path
    d="M24 14c-4 1-7 3-9 6l-4 6"
    stroke="var(--brand)"
    stroke-width="4"
    stroke-linecap="round"
  />
  <path
    d="M24 14c3 1 5 3 6 6l3 5"
    stroke="var(--accent)"
    stroke-width="4"
    stroke-linecap="round"
  />
  <path
    d="M18 22l2 7-4 7"
    stroke="var(--brand)"
    stroke-width="4"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path d="M6 15h8M4 21h6" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" />
</svg>
