---
import { Image } from 'astro:assets';
import logoMark from '../assets/logo.png';

interface Props {
  size?: number;
}

const { size = 34 } = Astro.props;
---

{/* The author's own mark: a figure in motion drawn out of a shoulder and a
    knee. Decorative — every place that uses it puts the site name in text
    beside it and labels the link, so the alt text stays empty rather than
    repeating the name to a screen reader twice.

    The source is a square, transparent PNG, so it sits on either theme without
    a plate behind it. Being raster it cannot pick up --brand and --accent the
    way the old placeholder SVG did; that is the trade for using the real mark. */}
<Image
  src={logoMark}
  alt=""
  width={size}
  height={size}
  densities={[1, 2]}
  loading="eager"
  class="shrink-0"
/>
