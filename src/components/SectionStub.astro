---
import Container from './Container.astro';
import { t, type Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import { getSection } from '../data/sections';

interface Props {
  locale: Locale;
  sectionId: string;
}

const { locale, sectionId } = Astro.props;
const tr = t(locale);
const section = getSection(sectionId);

/**
 * A planned section still gets a real page. The navigation in the design has
 * eight entries, and a reader who taps one deserves to be told what is coming
 * and where to go now — not a 404, and not a menu item that quietly does
 * nothing.
 */
const fallbacks =
  section.fallback === 'search'
    ? [{ path: '/search', label: tr('search.label') }]
    : [{ path: '/conditions', label: tr('nav.conditions') }];
---

<Container width="prose">
  <div class="py-12">
    <p
      class="m-0 inline-block rounded-full bg-brand-soft px-3 py-1 text-sm font-medium text-ink"
    >
      {tr('section.inProgress')}
    </p>

    <h1 class="mt-4">{section.title[locale]}</h1>
    <p class="text-lg text-muted">{section.intro[locale]}</p>

    <p class="mt-8">{tr('section.plannedBody')}</p>

    <ul class="m-0 mt-5 flex list-none flex-wrap gap-3 p-0">
      {
        [...fallbacks, { path: '/', label: tr('nav.home') }].map((item) => (
          <li>
            <a
              href={localizePath(item.path, locale)}
              class="inline-block rounded-full border border-border bg-surface px-5 py-2.5 text-ink no-underline hover:border-accent"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Container>
