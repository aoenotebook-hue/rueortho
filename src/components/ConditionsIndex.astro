---
import Container from './Container.astro';
import Card from './Card.astro';
import { t, type Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import { orderedRegions } from '../data/regions';
import { getConditions } from '../lib/conditions';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const conditions = await getConditions(locale);

// Region order comes from regions.ts; titles are sorted within each region.
const order = new Map(orderedRegions.map((r, i) => [r.id, i]));
const sorted = [...conditions].sort((a, b) => {
  const byRegion = (order.get(a.data.region) ?? 99) - (order.get(b.data.region) ?? 99);
  return byRegion !== 0 ? byRegion : a.data.title.localeCompare(b.data.title, locale);
});

const usedRegions = orderedRegions.filter((r) => sorted.some((c) => c.data.region === r.id));
---

<Container>
  <div class="py-10">
    <h1>{tr('nav.conditions')}</h1>

    <div class="my-6 max-w-[28rem]">
      <label class="visually-hidden" for="condition-filter">{tr('search.label')}</label>
      <input
        id="condition-filter"
        type="search"
        placeholder={tr('search.placeholder')}
        autocomplete="off"
        class="w-full rounded-[6px] border border-border bg-surface px-4 py-3 text-ink"
        data-filter-input
      />
    </div>

    {
      usedRegions.length > 1 && (
        <div class="mb-7 flex flex-wrap gap-2" role="group" aria-label={tr('nav.regions')}>
          <button
            type="button"
            class="rounded-full border border-accent bg-info-ground px-4 py-2 text-info-ink"
            data-region-chip="all"
            aria-pressed="true"
          >
            {tr('region.allRegions')}
          </button>
          {usedRegions.map((region) => (
            <button
              type="button"
              class="rounded-full border border-border bg-surface px-4 py-2 text-ink"
              data-region-chip={region.id}
              aria-pressed="false"
            >
              {region.label[locale]}
            </button>
          ))}
        </div>
      )
    }

    <ul
      class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(17rem,1fr))] gap-4 p-0"
      data-condition-list
    >
      {
        sorted.map((entry) => (
          <li
            data-region={entry.data.region}
            data-search={[entry.data.title, entry.data.summary, ...entry.data.keywords]
              .join(' ')
              .toLowerCase()}
          >
            <Card
              href={localizePath(`/conditions/${entry.data.slug}`, locale)}
              title={entry.data.title}
              summary={entry.data.summary}
              region={entry.data.region}
              locale={locale}
            />
          </li>
        ))
      }
    </ul>

    <p class="mt-6 text-muted" hidden data-empty>{tr('error.404.body')}</p>
  </div>
</Container>

<script>
  // Progressive enhancement: without JavaScript the full list is already shown.
  const input = document.querySelector<HTMLInputElement>('[data-filter-input]');
  const list = document.querySelector<HTMLElement>('[data-condition-list]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-region-chip]'));

  if (list) {
    const items = Array.from(list.querySelectorAll<HTMLLIElement>('li'));
    let region = 'all';

    const apply = () => {
      const query = (input?.value ?? '').trim().toLowerCase();
      let shown = 0;

      for (const item of items) {
        const matchesRegion = region === 'all' || item.dataset.region === region;
        const matchesQuery = query === '' || (item.dataset.search ?? '').includes(query);
        const visible = matchesRegion && matchesQuery;
        item.hidden = !visible;
        if (visible) shown++;
      }

      if (empty) empty.hidden = shown !== 0;
    };

    input?.addEventListener('input', apply);

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        region = chip.dataset.regionChip ?? 'all';
        for (const other of chips) {
          const active = other === chip;
          other.setAttribute('aria-pressed', String(active));
          other.classList.toggle('border-accent', active);
          other.classList.toggle('bg-info-ground', active);
          other.classList.toggle('text-info-ink', active);
          other.classList.toggle('border-border', !active);
          other.classList.toggle('bg-surface', !active);
          other.classList.toggle('text-ink', !active);
        }
        apply();
      });
    }
  }
</script>
