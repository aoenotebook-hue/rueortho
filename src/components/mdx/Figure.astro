---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { isPortrait } from '../../lib/image-shape';
import { t } from '../../i18n/ui';
import { getLocaleFromUrl } from '../../i18n/utils';

interface Props {
  /** An imported image (preferred, gets optimised) or a path under /public. */
  src: ImageMetadata | string;
  /** Required. Describe what the image shows, not that it is an image. */
  alt: string;
  caption?: string;
  /** Where the image came from, e.g. "Servier Medical Art". */
  attribution?: string;
  /** Licence of the source, e.g. "CC BY 4.0". */
  license?: string;
  /**
   * The file's own pixel size — for a `src="/…"` path only, and both or
   * neither.
   *
   * An imported image carries its dimensions and `<Image>` writes them out. A
   * path does not, so the browser lays the figure out with a zero-height box
   * and reflows the rest of the article when the lazy file arrives. Passing
   * both reserves the right box before the fetch.
   */
  width?: number;
  height?: number;
  /**
   * Make the picture a link to its own full-size file, with a line under it
   * saying so. For a picture whose words have to be read — the infographic
   * posters — rather than looked at: in the column they are a summary, and a
   * reader who wants the small print opens the file and zooms. A plain link,
   * so it needs no script and the CSP has nothing to hash. `src="/…"` only.
   */
  enlarge?: boolean;
}

const { src, alt, caption, attribution, license, width, height, enlarge } = Astro.props;

if (enlarge && typeof src !== 'string') {
  throw new Error('<Figure enlarge> needs a src="/…" path under public/, so the link has a file to open.');
}

const enlargeLabel = t(getLocaleFromUrl(Astro.url))('media.enlarge');

/*
 * A portrait picture is capped narrower than the 34rem every figure gets. The
 * app photographs are 4:5 and 3:4 people standing up; at the full figure width
 * a 4:5 frame is 42rem tall, more than a laptop screen, and the sentence it
 * illustrates scrolls away above it. 20rem is the cap exercise-card portraits
 * already use.
 */
const portrait = isPortrait(src, width, height);

if (!alt) {
  throw new Error('<Figure> requires an alt description — it is not optional on this site.');
}
---

<figure class:list={[portrait && !enlarge && 'figure-portrait', enlarge && 'figure-enlarge']}>
  {
    enlarge && typeof src === 'string' ? (
      <a href={src} class="figure-enlarge-link">
        <img
          src={src}
          alt={alt}
          width={width}
          height={height}
          loading="lazy"
          decoding="async"
          class="rounded-[10px] border border-border"
        />
        <span class="caption mt-2 block">{enlargeLabel}</span>
      </a>
    ) : typeof src === 'string' ? (
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
        class="rounded-[10px]"
      />
    ) : (
      <Image src={src} alt={alt} widths={[400, 800]} loading="lazy" class="rounded-[10px]" />
    )
  }

  {
    (caption || attribution) && (
      <figcaption class="caption mt-2">
        {caption}
        {attribution && (
          <span class="block">
            {attribution}
            {license ? `, ${license}` : null}
          </span>
        )}
      </figcaption>
    )
  }
</figure>
