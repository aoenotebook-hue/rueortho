---
import type { ImageMetadata } from 'astro';
import { isPortrait } from '../../lib/image-shape';
import { Image } from 'astro:assets';
import { t } from '../../i18n/ui';
import { getLocaleFromUrl } from '../../i18n/utils';
import { clipFrameClass, getClipSize } from '../../lib/clip-size';

interface Props {
  title: string;
  /** e.g. "10 ครั้ง" / "10 repetitions" */
  reps?: string;
  /** e.g. "2 เซ็ต" / "2 sets" */
  sets?: string;
  /** e.g. "ค้างไว้ 20 วินาที" / "hold 20 seconds" */
  hold?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  /**
   * Where the picture came from, rendered under it exactly as `<Figure>` does.
   *
   * The site's rule is that an image may not be published unless its source can
   * be stated truthfully, and an exercise picture is no different from a figure
   * in that respect. The app-derived cards in frozen-shoulder, osteoporosis and
   * rotator-cuff-tear predate this prop and carry their credit as a line of body
   * text instead; that wording is the author's to confirm, so it was left alone
   * rather than migrated.
   */
  imageAttribution?: string;
  /**
   * The picture's own pixel size, for a `image="/…"` path only.
   *
   * An import carries its dimensions and `<Image>` writes them out; a string
   * path does not, so the browser lays the card out with a zero-height box and
   * then reflows it when the file arrives. These pictures are lazy and tall —
   * 765x1024 — so that reflow moved the rest of the article by the better part
   * of a screen on a phone. Passing both sizes reserves the right box before
   * the fetch.
   */
  imageWidth?: number;
  imageHeight?: number;
  /**
   * A demonstration clip under public/, e.g. "/media/frozen-shoulder/pendulum.mp4".
   *
   * The card's picture becomes the clip's poster: the reader sees the still,
   * with a play badge over it, and tapping it swaps in the clip — the same
   * click-to-load `<Video>` uses, so nothing downloads until it is asked for.
   * Needs `image` for the poster and `videoDescription` for anyone who cannot
   * see the clip.
   */
  video?: string;
  /** What happens in the clip, for a screen reader. Required with `video`. */
  videoDescription?: string;
  /** YouTube video id. Nothing from Google loads until the reader presses play. */
  youtube?: string;
  /** Still image shown in place of the video before it is loaded. */
  poster?: string;
}

const {
  title,
  reps,
  sets,
  hold,
  image,
  imageAlt,
  imageAttribution,
  imageWidth,
  imageHeight,
  video,
  videoDescription,
  youtube,
  poster,
} = Astro.props;

if (video && (!image || !videoDescription)) {
  throw new Error(`<ExerciseCard title="${title}"> has a video but no image to use as its poster, or no videoDescription.`);
}

/*
 * Portrait pictures are capped narrower than landscape ones. The app stills
 * come in both shapes — 3:4 and 4:5 figures standing up, 16:9 scenes of a
 * whole room — and one cap for both either buries a short card under a tall
 * portrait or shrinks a room scene to a thumbnail.
 */
const portrait = isPortrait(image, imageWidth, imageHeight);

if (image && !imageAlt) {
  throw new Error(`<ExerciseCard title="${title}"> has an image but no imageAlt.`);
}

const meta = [sets, reps, hold].filter(Boolean);

/*
 * The play control and the frame it becomes are named in the reader's own
 * language, the same way <Video> does it. Both used to be English literals —
 * "<title> — play video" and a bare "Video" — which on a Thai page gave a
 * screen reader an English name for a Thai exercise.
 */
const tr = t(getLocaleFromUrl(Astro.url));
const playLabel = `${tr('media.play')} — ${title}`;
/*
 * The player is sized by the clip's shape, not the still's: a square still
 * (chin tuck, shoulder-blade squeeze) hides a 9:16 clip, which the landscape
 * size then played at 30rem wide and 75vh tall between black bars.
 */
const clipIsTall = video ? clipFrameClass(getClipSize(video)) === 'clip-frame-tall' : portrait;
const videoClass = clipIsTall
  ? 'block max-h-[75vh] w-full max-w-[min(20rem,100%)] rounded-[10px] border border-border bg-black'
  : 'block max-h-[75vh] w-full max-w-[min(30rem,100%)] rounded-[10px] border border-border bg-black';
---

<article class="exercise-card my-6 rounded-[10px] border border-border bg-surface p-5">
  <h3 class="mt-0! mb-2 text-[1.125rem]">{title}</h3>

  {
    meta.length > 0 && (
      <p class="m-0 mb-3 text-sm text-muted">{meta.join(' · ')}</p>
    )
  }

  <div class="exercise-body">
    <slot />
  </div>

  {
    image && (
      <figure class:list={['mt-4 mb-0', portrait ? 'is-portrait' : 'is-landscape']}>
        {video ? (
          <>
            <button
              type="button"
              class="video-facade group relative block overflow-hidden rounded-[10px] text-start"
              data-video={video}
              data-title={title}
              data-video-class={videoClass}
              data-unavailable={tr('media.unavailable')}
              aria-label={playLabel}
              aria-describedby={`${video}-desc`}
            >
              {typeof image === 'string' ? (
                <img src={image} alt="" width={imageWidth} height={imageHeight} loading="lazy" decoding="async" class="block" />
              ) : (
                <Image src={image} alt="" widths={[400, 800]} loading="lazy" class="block" />
              )}
              <span
                class="pointer-events-none absolute inset-0 grid place-items-center bg-black/15 transition group-hover:bg-black/25"
                aria-hidden="true"
              >
                <span class="rounded-full bg-accent px-4 py-2.5 text-lg text-accent-contrast shadow-[0_2px_10px_rgba(0,0,0,0.35)] ring-2 ring-white/70">
                  ▶
                </span>
              </span>
            </button>
            <span id={`${video}-desc`} class="sr-only">{videoDescription}</span>
            <p class="m-0 mt-2 text-sm text-muted">{tr('media.videoHint')}</p>
          </>
        ) : typeof image === 'string' ? (
          <img
            src={image}
            alt={imageAlt}
            width={imageWidth}
            height={imageHeight}
            loading="lazy"
            decoding="async"
            class="rounded-[10px]"
          />
        ) : (
          <Image src={image} alt={imageAlt!} widths={[400, 800]} loading="lazy" class="rounded-[10px]" />
        )}
        {imageAttribution && (
          <figcaption class="caption mt-2">{imageAttribution}</figcaption>
        )}
      </figure>
    )
  }

  {
    youtube && (
      <div class="mt-4">
        <button
          type="button"
          class="video-facade relative w-full overflow-hidden rounded-[10px] border border-border"
          data-youtube={youtube}
          data-frame-title={playLabel}
          aria-label={playLabel}
        >
          {poster ? (
            <img src={poster} alt="" loading="lazy" class="block w-full" />
          ) : (
            <span class="block bg-ground py-12" />
          )}
          <span
            class="pointer-events-none absolute inset-0 grid place-items-center text-3xl text-accent-contrast"
            aria-hidden="true"
          >
            <span class="rounded-full bg-accent px-5 py-3">▶</span>
          </span>
        </button>
      </div>
    )
  }
</article>

<style is:global>
  .exercise-body p:last-child {
    margin-bottom: 0;
  }

  /*
   * The exercise pictures are 765x1024 portraits. Uncapped they take the full
   * width of the card — about 680px on a desktop, and so 910px tall — which
   * turns a short set of instructions into a page of photograph. 20rem keeps
   * the picture beside its own text rather than burying it, and is the same
   * cap the article hero uses for a square illustration.
   *
   * A landscape still — the app scenes are 16:9 — gets 30rem instead: at
   * 20rem a whole room shrinks until the person in it is a few pixels tall.
   * On a phone both caps are wider than the card, so both fill it.
   */
  .exercise-card figure.is-portrait img,
  .exercise-card figure.is-portrait .video-facade {
    max-width: min(20rem, 100%);
  }

  .exercise-card figure.is-landscape img,
  .exercise-card figure.is-landscape .video-facade {
    max-width: min(30rem, 100%);
  }

  .exercise-body ul,
  .exercise-body ol {
    padding-inline-start: 1.3em;
  }

  .exercise-body ul {
    list-style: disc;
  }

  .exercise-body ol {
    list-style: decimal;
  }
</style>

<script>
  import '../../scripts/video-facade';
</script>

<script>
  // Click-to-load: no request reaches Google until the reader asks for the video.
  document.addEventListener('click', (event) => {
    const facade = (event.target as HTMLElement)?.closest<HTMLElement>('[data-youtube]');
    if (!facade) return;

    const id = facade.dataset.youtube;
    if (!id) return;

    const frame = document.createElement('iframe');
    frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
    frame.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
    frame.allowFullscreen = true;
    frame.loading = 'lazy';
    // Localised, and carried on the facade so the script holds no visible text.
    frame.title = facade.dataset.frameTitle ?? facade.getAttribute('aria-label') ?? '';
    frame.className = 'aspect-video w-full rounded-[10px] border border-border';

    facade.replaceWith(frame);
    // Keyboard activation lands the reader on the player rather than back at
    // the top of the document. An iframe is focusable, but only once it is in
    // the document — hence focus() after replaceWith(), not before.
    frame.focus();
  });
</script>
