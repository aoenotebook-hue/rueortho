---
import { t } from '../../i18n/ui';
import { getLocaleFromUrl } from '../../i18n/utils';

interface Props {
  /** Pass `frontmatter.redFlags` so the list is never written twice. */
  flags?: string[];
  /**
   * `frontmatter.seeDoctorSoon` — worth a doctor, but not tonight.
   *
   * Two blocks rather than one list with two kinds of thing in it. A list
   * headed "go to hospital now" that also contains "if it is no better in two
   * weeks" teaches the reader that the heading is an exaggeration, and the one
   * line that really means tonight gets read at the same weight as the rest.
   */
  soon?: string[];
}

const { flags = [], soon = [] } = Astro.props;
const tr = t(getLocaleFromUrl(Astro.url));
---

{
  flags.length > 0 && (
    <aside
      class="red-flags my-7 rounded-[10px] border border-s-4 border-warning-border bg-warning-ground p-5 text-warning-ink"
      role="note"
    >
      <p class="m-0 mb-2 flex items-center gap-2 font-semibold">
        {/* Shape as well as colour, per the site's own rule — the two blocks
            must not be told apart by colour alone. */}
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="shrink-0"
        >
          <path d="M8.5 2.5h7L21.5 8.5v7L15.5 21.5h-7L2.5 15.5v-7z" />
          <path d="M12 8v5M12 16h.01" />
        </svg>
        {tr('article.redFlagsTitle')}
      </p>
      <p class="m-0 mb-3">{tr('article.redFlagsUrgent')}</p>
      <ul class="m-0 list-disc ps-5">
        {flags.map((flag) => (
          <li class="mt-1">{flag}</li>
        ))}
      </ul>
    </aside>
  )
}

{
  soon.length > 0 && (
    <aside
      class="see-soon my-7 rounded-[10px] border border-s-4 border-info-border bg-info-ground p-5 text-info-ink"
      role="note"
    >
      <p class="m-0 mb-2 flex items-center gap-2 font-semibold">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="shrink-0"
        >
          <rect x="3" y="5" width="18" height="16" rx="2" />
          <path d="M8 3v4M16 3v4M3 10h18M12 14v3M10.5 15.5h3" />
        </svg>
        {tr('article.seeSoonTitle')}
      </p>
      <p class="m-0 mb-3">{tr('article.seeSoonBody')}</p>
      <ul class="m-0 list-disc ps-5">
        {soon.map((item) => (
          <li class="mt-1">{item}</li>
        ))}
      </ul>
    </aside>
  )
}
