---
import { existsSync } from 'node:fs';
import { t } from '../../i18n/ui';
import { getLocaleFromUrl } from '../../i18n/utils';

interface Props {
  /** Path under public/, e.g. "/media/frozen-shoulder/wall-slide.mp4". */
  src: string;
  /** What the clip demonstrates. Read out as the button's accessible name. */
  title: string;
  /**
   * A text description of what happens in the clip, for anyone who cannot see
   * it. Required: a silent demonstration video carries all of its meaning in
   * the picture, so without this the content simply is not there.
   */
  description: string;
  caption?: string;
  attribution?: string;
  /**
   * Still shown before the clip loads.
   *
   * Optional, and normally left out: `scripts/make-video-posters.mjs` cuts a
   * frame from every clip in `public/media/` to `<name>.poster.webp`, and the
   * component picks that up by convention. Pass this only to override it.
   */
  poster?: string;
}

const { src, title, description, caption, attribution, poster } = Astro.props;

if (!description) {
  throw new Error(`<Video title="${title}"> needs a description — it is what a blind reader gets instead of the picture.`);
}

const tr = t(getLocaleFromUrl(Astro.url));

/**
 * The poster, by convention rather than by hand.
 *
 * A clip used to open onto a flat grey panel, so before pressing play the
 * reader had only the caption's word for what it showed — and on a silent
 * demonstration that is most of the point. Every clip now has a frame cut from
 * itself sitting beside it.
 *
 * Checked on disk at build time rather than assumed: a clip added before its
 * poster is generated falls back to the old panel instead of a broken image.
 */
const derivedPoster = src.replace(/\.mp4$/, '.poster.webp');
const still =
  poster ?? (existsSync(`public${derivedPoster}`) ? derivedPoster : undefined);
---

{/*
  Click-to-load. The <video> element is created only when the reader asks for
  it, so an article carrying ten clips still downloads none of them on load.
  The facade shows the clip's poster, or a plain panel if it has none.
*/}
<figure class="my-8">
  <button
    type="button"
    class="video-facade group relative block w-full overflow-hidden rounded-[10px] border border-border bg-surface text-start"
    data-video={src}
    data-title={title}
    data-unavailable={tr('media.unavailable')}
    aria-label={`${tr('media.play')} — ${title}`}
  >
    {
      still ? (
        <img
          src={still}
          alt=""
          width="960"
          height="540"
          loading="lazy"
          decoding="async"
          class="block aspect-video w-full bg-ground object-contain"
        />
      ) : (
        <span class="block aspect-video w-full bg-ground" />
      )
    }
    {/* Over a photograph the badge needs its own contrast: a scrim behind it
        and a ring around it, so it reads on a light frame as well as a dark
        one. */}
    <span
      class="pointer-events-none absolute inset-0 grid place-items-center bg-black/15 transition group-hover:bg-black/25"
      aria-hidden="true"
    >
      <span class="rounded-full bg-accent px-5 py-3 text-xl text-accent-contrast shadow-[0_2px_10px_rgba(0,0,0,0.35)] ring-2 ring-white/70">
        ▶
      </span>
    </span>
  </button>

  <p class="m-0 mt-2 text-sm text-muted">{tr('media.videoHint')}</p>

  <figcaption class="caption mt-2">
    <span class="block font-semibold text-ink">{title}</span>
    <span class="mt-1 block">{caption ?? description}</span>
    {attribution && <span class="mt-1 block">{attribution}</span>}
  </figcaption>
</figure>

<script>
  import '../../scripts/video-facade';
</script>
