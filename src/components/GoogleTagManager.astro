---
/**
 * The Google Tag Manager loader, for the top of <body>.
 *
 * Google's instructions say to paste an inline <script> as high in the head as
 * possible. Our Content-Security-Policy refuses inline script — Astro hashes
 * only what it generates itself — so the snippet lives in `public/gtm.js` and
 * is pulled in from our own origin instead. It is a normal blocking script at
 * the top of <body>, so it still runs before the page renders, which is what
 * "as high as possible" is asking for. It is not in <head> because the CSP is a
 * <meta> tag Astro writes at the end of <head>, and a meta policy governs only
 * what comes after it — see the comment in `BaseLayout.astro`. `public/gtm.js`
 * explains the rest.
 *
 * Renders nothing when no container id is set, so switching GTM off is one
 * line in `src/data/site.ts`.
 */
import { site } from '../data/site';

const containerId = site.gtmContainerId;
---

{containerId && <script src="/gtm.js" data-gtm-id={containerId} is:inline />}
