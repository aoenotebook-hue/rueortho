---
import type { RegionId } from '../data/regions';

interface Props {
  region: RegionId;
  size?: number;
}

const { region, size = 40 } = Astro.props;

/**
 * Simple anatomical glyphs, drawn in currentColor so they follow the theme.
 * Deliberately not photographs: the mockup used stock imagery, which would
 * need licensing and would not adapt to dark mode.
 *
 * Decorative — the visible label beside each icon carries the meaning, so the
 * SVG is aria-hidden.
 */
const paths: Record<string, string> = {
  // Stacked vertebrae with a gentle curve.
  spine: `
    <path d="M20 6c-3 0-5 2-5 4s2 3 5 3 5-1 5-3-2-4-5-4z"/>
    <path d="M19 15c-3 0-5 2-5 4s2 3 5 3 5-1 5-3-2-4-5-4z"/>
    <path d="M19 24c-3 0-5 2-5 4s2 3 5 3 5-1 5-3-2-4-5-4z"/>
    <path d="M11 10h-3M11 19h-3M11 28h-3M28 10h3M29 19h3M28 28h3"/>
  `,
  // Ball-and-socket with the upper arm hanging from it.
  shoulder: `
    <circle cx="15" cy="14" r="7"/>
    <path d="M22 12c4-1 8 0 10 3"/>
    <path d="M17 21c0 6 1 9 3 13"/>
    <path d="M25 18c2 5 3 10 2 16"/>
  `,
  // Bent arm at the elbow.
  elbow: `
    <path d="M10 7v10c0 5 3 8 8 9"/>
    <circle cx="14" cy="19" r="5"/>
    <path d="M19 26c4 2 8 3 13 3"/>
  `,
  // Hand with fingers and a wrist band.
  'hand-wrist': `
    <path d="M14 20V9a2 2 0 0 1 4 0v9"/>
    <path d="M18 18V7a2 2 0 0 1 4 0v11"/>
    <path d="M22 18V9a2 2 0 0 1 4 0v10"/>
    <path d="M26 19v-6a2 2 0 0 1 4 0v11c0 6-4 10-9 10s-9-4-9-9v-7a2 2 0 0 1 4 0"/>
    <path d="M13 33h14"/>
  `,
  // Pelvis with the femoral head seated in it.
  hip: `
    <path d="M8 10c0 8 3 12 8 13"/>
    <path d="M32 10c0 8-3 12-8 13"/>
    <path d="M8 10h24"/>
    <circle cx="24" cy="22" r="5"/>
    <path d="M26 27c1 4 1 7 0 10"/>
  `,
  // Femur, patella and tibia.
  knee: `
    <path d="M16 5v9c0 2 1 3 3 3"/>
    <path d="M24 5v9c0 2-1 3-3 3"/>
    <circle cx="20" cy="20" r="4"/>
    <path d="M17 24c-1 4-1 8-1 12"/>
    <path d="M23 24c1 4 1 8 1 12"/>
  `,
  // Foot in profile with the ankle joint marked.
  'foot-ankle': `
    <path d="M16 6v10"/>
    <circle cx="16" cy="19" r="4"/>
    <path d="M13 23c-2 3-3 6-3 8h22c0-3-3-5-8-6-4-1-7-2-11-2z"/>
  `,
};

const d = paths[region] ?? '';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={d}
/>
