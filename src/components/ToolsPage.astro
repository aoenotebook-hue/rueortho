---
import Container from './Container.astro';
import QrCode from './QrCode.astro';
import { t, type Locale } from '../i18n/ui';
import { getSection } from '../data/sections';
import { apps } from '../data/apps';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const section = getSection('tools');

const liveApps = apps.filter((app) => app.status === 'live');

/**
 * Built from Astro.site, so the code follows the configured origin in
 * `src/data/site.ts` rather than a value copied by hand. It now encodes the
 * live Vercel address; if a custom domain is mapped later, changing that one
 * line regenerates every code here.
 */
const siteUrl = new URL(locale === 'th' ? '/' : '/en/', Astro.site).href;
---

<Container>
  <div class="py-10">
    <h1>{section.title[locale]}</h1>
    <p class="max-w-[60ch] text-lg text-muted">{section.intro[locale]}</p>

    <!-- The apps -->
    <section class="mt-10 rounded-[var(--radius-panel)] border border-border bg-surface p-6 md:p-8">
      <h2 class="m-0">{tr('tools.appsTitle')}</h2>
      <p class="m-0 mt-1 max-w-[62ch] text-muted">{tr('tools.appsIntro')}</p>

      <ul class="m-0 mt-7 grid list-none grid-cols-[repeat(auto-fit,minmax(min(23rem,100%),1fr))] gap-6 p-0">
        {
          liveApps.map((app) => (
            <li class="flex flex-col gap-4 rounded-[10px] border border-border p-5 sm:flex-row">
              <div class="shrink-0">
                <QrCode url={app.url} label={tr('tools.qrFor', { name: app.name[locale] })} />
              </div>

              <div class="min-w-0 flex-1">
                <h3 class="mt-0! mb-2 text-[1.05rem]">{app.name[locale]}</h3>
                <p class="m-0 text-[0.95em] text-muted">{app.description[locale]}</p>
                <p class="m-0 mt-2 text-sm text-muted">{tr('tools.scanToOpen')}</p>
                <a
                  href={app.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-block rounded-full border border-accent px-5 py-2 text-ink no-underline hover:bg-brand-soft"
                >
                  {tr('apps.open')}
                </a>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="m-0 mt-6 text-sm text-muted">{tr('apps.free')}</p>
    </section>

    <!-- Share the site itself -->
    <section class="mt-8 rounded-[var(--radius-panel)] border border-border bg-surface p-6 md:p-8">
      <h2 class="m-0">{tr('tools.shareTitle')}</h2>
      <p class="m-0 mt-1 max-w-[62ch] text-muted">{tr('tools.shareIntro')}</p>

      <div class="mt-6 flex flex-col items-start gap-5 sm:flex-row sm:items-center">
        <QrCode url={siteUrl} label={tr('tools.scanSite')} />
        <div class="min-w-0">
          <p class="m-0 font-semibold text-ink">{tr('site.name')}</p>
          <p class="m-0 mt-1 text-muted">{tr('brand.promise')}</p>
          <p class="m-0 mt-2 text-sm text-muted">{tr('tools.scanSite')}</p>
        </div>
      </div>
    </section>
  </div>
</Container>
