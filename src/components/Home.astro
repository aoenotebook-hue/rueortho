---
import Container from './Container.astro';
import { Image } from 'astro:assets';
import RegionArt from './RegionArt.astro';
import BodyMap from './BodyMap.astro';
import heroImage from '../assets/hero-shoulder-pain.png';
import { t, type Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import { bodyMapRegions } from '../data/regions';
import { getFeaturedConditions, getRecentlyReviewed, getRegionCounts } from '../lib/conditions';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

const counts = await getRegionCounts(locale);

/**
 * The featured strip is a chosen list of slugs (`src/data/featured.ts`)
 * resolved against what this locale publishes, so both languages lead with the
 * same topics in the same order and a missing or unfinished article simply
 * does not appear.
 *
 * The reviewed strip below it then skips whatever the featured strip already
 * shows: two lists on one screen with the same article in both is a waste of
 * the reader's attention. There are twenty conditions and nine slots between
 * them, so nothing has to be padded to fill the row.
 */
const featured = await getFeaturedConditions(locale);
const featuredSlugs = new Set(featured.map((entry) => entry.data.slug));
const recentlyReviewed = await getRecentlyReviewed(locale, 3, featuredSlugs);

const searchPath = localizePath('/search', locale);

/** Symptom words a reader would actually type, wired to real searches. */
const examples =
  locale === 'th'
    ? ['ปวดเข่า', 'ไหล่ติด', 'ปวดหลัง', 'มือชา', 'รองช้ำ']
    : ['knee pain', 'frozen shoulder', 'back pain', 'numb hand', 'heel pain'];

/**
 * The four entry points from the design. Each one points at a real page: until
 * the dedicated sections exist, they run a search that returns something
 * useful rather than a 404.
 */
const wantCards = [
  {
    title: tr('home.want1Title'),
    body: tr('home.want1Body'),
    href: localizePath('/conditions', locale),
    bg: 'bg-card-blue-bg',
    ink: 'text-card-blue-ink',
    icon: 'stethoscope',
  },
  {
    title: tr('home.want2Title'),
    body: tr('home.want2Body'),
    href: localizePath('/examinations', locale),
    bg: 'bg-card-green-bg',
    ink: 'text-card-green-ink',
    icon: 'scan',
  },
  {
    title: tr('home.want3Title'),
    body: tr('home.want3Body'),
    href: localizePath('/treatments', locale),
    bg: 'bg-card-orange-bg',
    ink: 'text-card-orange-ink',
    icon: 'pill',
  },
  {
    title: tr('home.want4Title'),
    body: tr('home.want4Body'),
    href: localizePath('/rehabilitation', locale),
    bg: 'bg-card-purple-bg',
    ink: 'text-card-purple-ink',
    icon: 'move',
  },
];

/**
 * Three levels of urgency. Each carries a distinct shape and a written label as
 * well as colour, because the plan's accessibility rule — and WCAG — forbid
 * conveying this by colour alone. Framed as guidance, never as a diagnosis.
 */
const triage = [
  {
    label: tr('triage.greenLabel'),
    body: tr('triage.greenBody'),
    bg: 'bg-card-green-bg',
    ink: 'text-card-green-ink',
    shape: 'check',
  },
  {
    label: tr('triage.amberLabel'),
    body: tr('triage.amberBody'),
    bg: 'bg-card-orange-bg',
    ink: 'text-card-orange-ink',
    shape: 'warn',
  },
  {
    label: tr('triage.redLabel'),
    body: tr('triage.redBody'),
    bg: 'bg-warning-ground',
    ink: 'text-warning-ink',
    shape: 'urgent',
  },
];

const trust = [
  { label: tr('trust.evidence'), icon: 'book' },
  { label: tr('trust.reviewed'), icon: 'shield' },
  { label: tr('trust.plain'), icon: 'people' },
  { label: tr('trust.life'), icon: 'pulse' },
];
---

<!-- Hero -->
<section class="hero-surface border-b border-border">
  <Container>
    <div class="grid items-center gap-8 py-12 lg:grid-cols-[1.1fr_0.9fr] lg:py-16">
      <!-- min-w-0: a grid item defaults to min-width:auto, and `overflow-wrap:
           break-word` does not reduce min-content contribution. A Thai heading
           is a single unbreakable token, so without this the column is sized to
           the full width of the site name and the page scrolls sideways. -->
      <div class="min-w-0">
        <h1 class="text-[2rem] leading-tight md:text-[2.6rem]">{tr('site.name')}</h1>
        <p class="mt-2 text-xl font-medium text-accent md:text-2xl">{tr('brand.promise')}</p>
        <p class="mt-4 max-w-[46ch] text-muted">{tr('hero.body')}</p>


        {/*
          One primary action, and one quiet way to the safety section beside
          it. Both are same-page anchors — `scroll-padding-top` in global.css
          is what keeps the heading they land on clear of the sticky header.

          Deliberately not a search box: the field that used to sit here was
          removed at the author's request, and the header's button is the one
          search entry point on the site. Repeating it here would be a second
          copy of the same control.
        */}
        <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a
            href="#where-it-hurts"
            class="rounded-full bg-accent px-6 py-3 font-medium text-accent-contrast no-underline hover:opacity-90"
          >
            {tr('home.primaryAction')} ↓
          </a>

          <a href="#when-to-see-a-doctor" class="text-[0.95em]">{tr('triage.title')}</a>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-2">
          <span class="text-sm text-muted">{tr('hero.exploreLabel')}</span>
          {
            examples.map((example) => (
              <a
                href={`${searchPath}?q=${encodeURIComponent(example)}`}
                class="rounded-full border border-border bg-surface px-4 py-1.5 text-sm text-ink no-underline hover:border-accent"
              >
                {example}
              </a>
            ))
          }
        </div>

        {/*
          How the words on this site are made, for a reader deciding whether to
          trust them. A link, not a byline: the author's name, his credentials
          and the review dates are deliberately not in the hero.
        */}
        <p class="mt-6 m-0 text-sm text-muted">
          <a href={localizePath('/editorial-policy', locale)}>{tr('home.editorialLink')}</a>
        </p>
      </div>

      {/*
        The illustration, and nothing else. It used to carry two more slogans —
        one above it and one overlapping its corner — which left the hero
        saying the same thing four times over: the site name, the promise, the
        purpose and then two more turns of phrase. The promise and the purpose
        say it; the picture does not need to say it again.
      */}
      {/*
        `loading="lazy"` rather than eager, and that is about the phone rather
        than the desktop. This column is `display: none` below lg, and an
        *eager* image inside a hidden box is still fetched: measured at 390px,
        the hero webp was downloaded in full — 6,986 bytes of a 29 KiB page —
        for a picture the reader never sees. A lazy image in a `display: none`
        box is not fetched at all. From lg up it is in the viewport when the
        page lays out, so it still starts immediately; `fetchpriority="high"`
        keeps it ahead of the region drawings further down.

        The picture stays off the phone entirely rather than appearing in a
        compact form. Measured at 390px, the primary action already sits 391px
        down in Thai and 406px in English, and "where does it hurt" at 680px
        and 730px — one screen on a phone, with nothing to spare. A 200px
        illustration above the fold pushes both past it, and the illustration
        is atmosphere where the button is the point.
      */}
      <div class="hidden lg:block">
        <Image
          src={heroImage}
          alt={tr('hero.imageAlt')}
          widths={[560, 760, 1120]}
          sizes="(min-width: 1024px) 34rem, 100vw"
          loading="lazy"
          fetchpriority="high"
          class="w-full rounded-[var(--radius-panel)] border border-border object-cover shadow-[var(--shadow-card)]"
        />
      </div>
    </div>
  </Container>
</section>

<!-- Where does it hurt? The hero's primary action lands here, so the id is
     part of the page's contract and must not be renamed casually. -->
<section id="where-it-hurts" class="py-10">
  <Container>
    <div class="rounded-[var(--radius-panel)] border border-border bg-surface p-6 md:p-8">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="m-0">{tr('home.whereTitle')}</h2>
          <p class="m-0 mt-1 text-muted">{tr('home.whereSub')}</p>
        </div>
        <a href={localizePath('/conditions', locale)} class="text-[0.95em]">
          {tr('common.viewAll')} →
        </a>
      </div>

      {/*
        The drawing is the primary way in from tablet up. Below that the labels
        would sit on top of each other, so the same regions render as the circle
        grid instead — same links, same order, laid out for a narrow screen.
      */}
      {/*
        The drawing is the way in from md up, and the circle grid below that.

        The tablet is the tight case and the map is sized for it rather than
        moved out of it — see BodyMap.astro, which scales the drawing, the tap
        targets and the leader lines per breakpoint so 768px keeps every label
        at full size inside the panel.
      */}
      <div class="hidden md:block">
        <BodyMap locale={locale} counts={counts} />
      </div>

      <div class="md:hidden">
      <ul
        class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(5.5rem,100%),1fr))] gap-4 p-0 text-center"
      >
        {
          bodyMapRegions.map((region) => {
            const count = counts[region.id] ?? 0;
            const label = region.label[locale];
            const inner = (
              <>
                <span
                  class:list={[
                    'mx-auto grid h-16 w-16 place-items-center overflow-hidden rounded-full border',
                    count > 0
                      ? 'border-border bg-ground text-accent'
                      : 'border-dashed border-border text-muted opacity-60',
                  ]}
                >
                  <RegionArt region={region.id} sizes="4rem" />
                </span>
                <span class="mt-2 block text-[0.9em]">{label}</span>
              </>
            );

            return (
              <li>
                {count > 0 ? (
                  <a
                    href={localizePath(`/regions/${region.id}`, locale)}
                    class="block text-ink no-underline hover:text-accent"
                  >
                    {inner}
                  </a>
                ) : (
                  <span class="block text-muted" title={tr('common.comingSoon')}>
                    {inner}
                  </span>
                )}
              </li>
            );
          })
        }
      </ul>
      </div>
    </div>
  </Container>
</section>

<!-- What would you like to know? -->
<section class="pb-10">
  <Container>
    <h2 class="m-0">{tr('home.wantTitle')}</h2>
    <p class="m-0 mt-1 text-muted">{tr('home.wantSub')}</p>

    <ul class="m-0 mt-6 grid list-none grid-cols-[repeat(auto-fit,minmax(min(15rem,100%),1fr))] gap-4 p-0">
      {
        wantCards.map((card) => (
          <li>
            <a
              href={card.href}
              class:list={[
                'group flex h-full flex-col rounded-[var(--radius-panel)] p-6 no-underline',
                card.bg,
                card.ink,
              ]}
            >
              <span class="mb-4 grid h-11 w-11 place-items-center rounded-[10px] bg-surface">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {card.icon === 'stethoscope' && (
                    <>
                      <path d="M6 3v6a5 5 0 0 0 10 0V3" />
                      <path d="M11 14v2a5 5 0 0 0 10 0v-2" />
                      <circle cx="20" cy="11" r="2" />
                    </>
                  )}
                  {card.icon === 'scan' && (
                    <>
                      <path d="M4 8V5a1 1 0 0 1 1-1h3M20 8V5a1 1 0 0 0-1-1h-3M4 16v3a1 1 0 0 0 1 1h3M20 16v3a1 1 0 0 1-1 1h-3" />
                      <path d="M9 8v8M15 8v8M9 12h6" />
                    </>
                  )}
                  {card.icon === 'pill' && (
                    <>
                      <rect x="3" y="9" width="18" height="6" rx="3" />
                      <path d="M12 9v6" />
                    </>
                  )}
                  {card.icon === 'move' && (
                    <>
                      <circle cx="13" cy="4" r="2" />
                      <path d="M11 8l-3 4 3 3 1 5M11 8l5 2 2 4M8 12l-4 1" />
                    </>
                  )}
                </svg>
              </span>

              <h3 class="mb-2 text-[1.05rem] leading-snug">{card.title}</h3>
              <p class="m-0 text-[0.92em] opacity-90">{card.body}</p>

              <span
                class="mt-4 grid h-8 w-8 place-items-center self-end rounded-full bg-surface"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<!-- Featured topics. A chosen starting selection, in a chosen order — not a
     ranking, and not "most searched": nothing here counts anything. The whole
     section is absent rather than empty when none of the featured slugs has a
     published article in this locale. -->
{
  featured.length > 0 && (
    <section class="pb-10">
      <Container>
        <div class="rounded-[var(--radius-panel)] border border-border bg-surface p-6 md:p-8">
          <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
            <div>
              <h2 class="m-0">{tr('home.featuredTitle')}</h2>
              <p class="m-0 mt-1 text-muted">{tr('home.featuredSub')}</p>
            </div>
            <a href={localizePath('/conditions', locale)} class="text-[0.95em]">
              {tr('home.viewAllConditions')} →
            </a>
          </div>

          <ul class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(min(20rem,100%),1fr))] gap-5 p-0">
            {featured.map((entry) => (
              <li>
                <a
                  href={localizePath(`/conditions/${entry.data.slug}`, locale)}
                  class="group flex h-full items-start gap-4 rounded-[10px] border border-border bg-surface p-4 no-underline transition hover:border-accent"
                >
                  {/*
                    A compact thumbnail rather than the banner panel this used
                    to be. Nine of these on one page, each a 4:3 box 185px tall
                    at 1280 and 225px at 390, was a lot of screen for
                    decoration — and `object-cover` was throwing away 25% of
                    the height of every square badge to do it, cutting the top
                    and bottom off the circle. Measured: seven of the nine
                    cropped, two did not.

                    The box keeps the 4:3 ratio so every card matches, and
                    `contain` lets both shapes of drawing sit in it whole.
                  */}
                  <span
                    class="grid aspect-[4/3] w-20 shrink-0 place-items-center overflow-hidden rounded-[8px] border border-border bg-ground text-accent transition group-hover:border-accent"
                    aria-hidden="true"
                  >
                    <RegionArt
                      region={entry.data.region}
                      image={entry.data.heroImage}
                      fit="contain"
                      sizes="5rem"
                    />
                  </span>

                  {/* min-w-0: a flex child defaults to min-width:auto and a
                      Thai title is one unbreakable token, so without this the
                      text column is sized to the whole title. */}
                  <span class="min-w-0">
                    <span class="block font-semibold text-ink group-hover:text-accent">
                      {entry.data.title}
                    </span>
                    {/* No `block` here: Tailwind's `line-clamp-2` works by
                        setting `display: -webkit-box`, and a `block` alongside
                        it wins and turns the clamp off. It had been inert since
                        this card was written — the summaries ran to six lines
                        and every card in the row was a different height. */}
                    <span class="mt-1 line-clamp-2 text-[0.9em] text-muted">
                      {entry.data.summary}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </Container>
    </section>
  )
}

<!-- When should I see a doctor? Guidance, explicitly not diagnosis. The hero
     links here by id; the wording inside is the author's and is unchanged. -->
<section id="when-to-see-a-doctor" class="pb-10">
  <Container>
    <div class="rounded-[var(--radius-panel)] border border-border bg-surface p-6 md:p-8">
      <h2 class="m-0">{tr('triage.title')}</h2>
      <p class="m-0 mt-1 text-muted">{tr('triage.sub')}</p>

      <ol class="m-0 mt-6 grid list-none grid-cols-[repeat(auto-fit,minmax(min(16rem,100%),1fr))] gap-4 p-0">
        {
          triage.map((level) => (
            <li class:list={['rounded-[10px] p-5', level.bg, level.ink]}>
              <p class="m-0 mb-2 flex items-center gap-2 font-semibold">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="shrink-0"
                >
                  {level.shape === 'check' && (
                    <>
                      <circle cx="12" cy="12" r="9" />
                      <path d="M8 12.5l2.5 2.5L16 9" />
                    </>
                  )}
                  {level.shape === 'warn' && (
                    <>
                      <path d="M12 3.5L22 20H2z" />
                      <path d="M12 10v4M12 17h.01" />
                    </>
                  )}
                  {level.shape === 'urgent' && (
                    <>
                      <path d="M8.5 2.5h7L21.5 8.5v7L15.5 21.5h-7L2.5 15.5v-7z" />
                      <path d="M12 8v5M12 16h.01" />
                    </>
                  )}
                </svg>
                {level.label}
              </p>
              <p class="m-0 text-[0.95em] opacity-90">{level.body}</p>
            </li>
          ))
        }
      </ol>

      <p class="m-0 mt-5 font-semibold text-warning-ink">{tr('triage.emergency')}</p>
    </div>
  </Container>
</section>

<!-- Recently reviewed. The list is ordered by `lastReviewed`, so it is named
     after that and not "latest articles", which would promise a publication
     order it does not have. The dates themselves stay off the page, for the
     same reason the article byline carries no date. -->
{
  recentlyReviewed.length > 0 && (
    <section class="pb-10">
      <Container>
        <div class="rounded-[var(--radius-panel)] border border-border bg-surface p-6 md:p-8">
          <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
            <h2 class="m-0">{tr('home.recentlyReviewed')}</h2>
            {/* The article hub, not the conditions index — this link said
                "all articles" and went somewhere else. */}
            <a href={localizePath('/articles', locale)} class="text-[0.95em]">
              {tr('home.viewAllArticles')} →
            </a>
          </div>

          <ul class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(min(20rem,100%),1fr))] gap-5 p-0">
            {recentlyReviewed.map((entry) => (
              <li>
                <a
                  href={localizePath(`/conditions/${entry.data.slug}`, locale)}
                  class="group flex h-full items-center gap-4 rounded-[10px] border border-border bg-surface p-4 no-underline transition hover:border-accent"
                >
                  {/*
                    A compact thumbnail rather than the banner panel this used
                    to be. Nine of these on one page, each a 4:3 box 185px tall
                    at 1280 and 225px at 390, was a lot of screen for
                    decoration — and `object-cover` was throwing away 25% of
                    the height of every square badge to do it, cutting the top
                    and bottom off the circle. Measured: seven of the nine
                    cropped, two did not.

                    The box keeps the 4:3 ratio so every card matches, and
                    `contain` lets both shapes of drawing sit in it whole.
                  */}
                  <span
                    class="grid aspect-[4/3] w-20 shrink-0 place-items-center overflow-hidden rounded-[8px] border border-border bg-ground text-accent transition group-hover:border-accent"
                    aria-hidden="true"
                  >
                    <RegionArt
                      region={entry.data.region}
                      image={entry.data.heroImage}
                      fit="contain"
                      sizes="5rem"
                    />
                  </span>

                  <span class="min-w-0 font-semibold text-ink group-hover:text-accent">
                    {entry.data.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </Container>
    </section>
  )
}

<!-- Trust marks -->
<section class="border-y border-border bg-surface py-8">
  <Container>
    <ul
      class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(14rem,100%),1fr))] gap-6 p-0 text-[0.95em]"
    >
      {
        trust.map((item) => (
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 shrink-0 text-brand"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {item.icon === 'book' && (
                <>
                  <path d="M4 5a2 2 0 0 1 2-2h5v18H6a2 2 0 0 1-2-2z" />
                  <path d="M20 5a2 2 0 0 0-2-2h-5v18h5a2 2 0 0 0 2-2z" />
                </>
              )}
              {item.icon === 'shield' && (
                <>
                  <path d="M12 3l7 3v6c0 5-3 8-7 9-4-1-7-4-7-9V6z" />
                  <path d="M9 12l2 2 4-4" />
                </>
              )}
              {item.icon === 'people' && (
                <>
                  <circle cx="9" cy="8" r="3" />
                  <path d="M3 20c0-3 3-5 6-5s6 2 6 5" />
                  <path d="M16 6a3 3 0 0 1 0 6M17 15c2 1 4 2 4 5" />
                </>
              )}
              {item.icon === 'pulse' && <path d="M3 12h4l2-5 4 10 2-5h6" />}
            </svg>
            <span class="text-ink">{item.label}</span>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
