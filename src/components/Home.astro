---
import Container from './Container.astro';
import Card from './Card.astro';
import { t, type Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import { orderedRegions } from '../data/regions';
import { getRecentlyReviewed, getRegionCounts } from '../lib/conditions';
import { getAuthor, byline } from '../data/authors';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

const counts = await getRegionCounts(locale);
const recent = await getRecentlyReviewed(locale, 6);
const author = getAuthor('sorawut');
---

<section class="border-b border-border bg-surface py-12">
  <Container>
    <h1 class="max-w-[20ch]">{tr('site.name')}</h1>
    <p class="max-w-[52ch] text-lg text-muted">{tr('site.tagline')}</p>
  </Container>
</section>

<section class="py-12">
  <Container>
    <h2>{tr('region.browseTitle')}</h2>
    <p class="mb-7 max-w-[60ch] text-muted">{tr('region.browseIntro')}</p>

    <ul class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(15rem,1fr))] gap-4 p-0">
      {
        orderedRegions.map((region) => {
          const count = counts[region.id] ?? 0;
          const label = region.label[locale];

          if (count === 0) {
            return (
              <li
                class="rounded-[10px] border border-dashed border-border p-5 text-muted"
                aria-disabled="true"
              >
                <span class="block text-ink opacity-60">{label}</span>
                <span class="text-sm">{tr('common.comingSoon')}</span>
              </li>
            );
          }

          return (
            <li>
              <Card
                href={localizePath(`/regions/${region.id}`, locale)}
                title={label}
                summary={tr('common.articleCount', { n: count })}
                locale={locale}
              />
            </li>
          );
        })
      }
    </ul>
  </Container>
</section>

{
  recent.length > 0 && (
    <section class="border-t border-border py-12">
      <Container>
        <h2>{tr('home.recentlyReviewed')}</h2>
        <ul class="m-0 mt-6 grid list-none grid-cols-[repeat(auto-fill,minmax(17rem,1fr))] gap-4 p-0">
          {recent.map((entry) => (
            <li>
              <Card
                href={localizePath(`/conditions/${entry.data.slug}`, locale)}
                title={entry.data.title}
                summary={entry.data.summary}
                region={entry.data.region}
                locale={locale}
              />
            </li>
          ))}
        </ul>
        <p class="mt-6">
          <a href={localizePath('/conditions', locale)}>{tr('common.viewAll')}</a>
        </p>
      </Container>
    </section>
  )
}

<section class="border-t border-border bg-surface py-12">
  <Container>
    <h2>{tr('home.aboutAuthor')}</h2>
    <div class="mt-5 flex flex-wrap items-start gap-5">
      <img
        src={author.photo}
        alt=""
        width="88"
        height="88"
        class="rounded-full border border-border"
      />
      <div class="max-w-[52ch]">
        <p class="m-0 font-semibold">{byline(author, locale)}</p>
        <p class="mt-2 mb-3 text-muted">{author.bio[locale][0]}</p>
        <a href={localizePath(`/about/author/${author.id}`, locale)}>{tr('home.readAuthor')}</a>
      </div>
    </div>
  </Container>
</section>
