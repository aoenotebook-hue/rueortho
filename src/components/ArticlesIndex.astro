---
import Container from './Container.astro';
import Card from './Card.astro';
import FilterBar from './FilterBar.astro';
import { t, type Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import { getSection, sections } from '../data/sections';
import { getConditions } from '../lib/conditions';
import { getResources } from '../lib/resources';
import { getTopicImage } from '../lib/topic-images';
import type { ResourceCollection } from '../lib/resources';
import type { RegionId } from '../data/regions';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const section = getSection('articles');

/**
 * This page indexes what already exists rather than adding anything of its own.
 * It is the one section that can be finished without the author reading new
 * medical copy, because every word it shows was written and reviewed somewhere
 * else on the site.
 */
const groups = [
  {
    id: 'conditions',
    /* No collection glyph: every condition carries a body region, so its card
       shows the author's drawing for that region instead. */
    collection: undefined as ResourceCollection | undefined,
    entries: (await getConditions(locale)).map((e) => ({
      title: e.data.title,
      summary: e.data.cardSummary ?? e.data.summary,
      href: localizePath(`/conditions/${e.data.slug}`, locale),
      image: e.data.heroImage,
      region: e.data.region as RegionId | undefined,
      search: [e.data.title, e.data.summary, ...e.data.keywords].join(' ').toLowerCase(),
    })),
  },
  ...(await Promise.all(
    (['basics', 'examinations', 'rehabilitation', 'treatments'] as const).map(async (id) => ({
      id,
      collection: id as ResourceCollection | undefined,
      entries: (await getResources(id, locale)).map((e) => ({
        title: e.data.title,
        summary: e.data.cardSummary ?? e.data.summary,
        href: localizePath(`/${id}/${e.data.slug}`, locale),
        image: getTopicImage(id, e.data.slug),
        region: undefined as RegionId | undefined,
        search: [e.data.title, e.data.summary, ...e.data.keywords].join(' ').toLowerCase(),
      })),
    })),
  )),
];

const total = groups.reduce((n, g) => n + g.entries.length, 0);

/**
 * Jump links to the groups this page actually has. The video gallery is one of
 * them, so it is named here rather than hard-coded into the markup, and a
 * group with nothing published never gets a link to an empty heading.
 */
const jumpTargets = [
  ...groups
    .filter((group) => group.entries.length > 0)
    .map((group) => ({
      id: group.id,
      label: sections.find((section) => section.id === group.id)!.title[locale],
    })),
];
---

<Container>
  <div class="py-10">
    <h1>{section.title[locale]}</h1>
    <p class="text-lg text-muted">{section.intro[locale]}</p>

    <p class="mt-2 text-muted">{tr('articles.count', { articles: total })}</p>

    {/*
      The clips moved to `/videos` on 2026-09-20 and this is the hub's way
      back to them. A link rather than the gallery itself: two copies of a
      list built from the same scan of the article bodies would be two places
      to keep in step, and the menu already carries the tab.
    */}
    <p class="mt-1">
      <a href={localizePath('/videos', locale)}>{tr('articles.videosLink')}</a>
    </p>

    {/*
      The page already says how much it holds, so the filter's own line stays
      quiet until it has something to add.
    */}
    <FilterBar
      locale={locale}
      total={total}
      resetHref={localizePath('/articles', locale)}
      showTotal={false}
    />

    {
      jumpTargets.length > 1 && (
        <nav aria-label={tr('articles.jumpLabel')} class="mb-2">
          <p class="m-0 text-sm text-muted">{tr('articles.jumpLabel')}</p>
          <ul class="m-0 mt-2 flex list-none flex-wrap gap-2 p-0">
            {jumpTargets.map((target) => (
              <li data-jump-for={target.id}>
                <a
                  href={`#${target.id}`}
                  class="inline-block rounded-full border border-border bg-surface px-4 py-2 text-[0.95em] text-ink no-underline hover:border-accent"
                >
                  {target.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      groups.map((group) =>
        group.entries.length === 0 ? null : (
          <section class="mt-12" id={group.id} data-filter-group={group.id}>
            <h2>{sections.find((s) => s.id === group.id)!.title[locale]}</h2>
            <ul class="m-0 mt-5 flex list-none flex-col gap-3 p-0">
              {group.entries.map((entry) => (
                <li data-filter-item data-search={entry.search}>
                  <Card
                    href={entry.href}
                    title={entry.title}
                    summary={entry.summary}
                    image={entry.image}
                    region={entry.region}
                    collection={group.collection}
                    locale={locale}
                  />
                </li>
              ))}
            </ul>
          </section>
        ),
      )
    }
  </div>
</Container>
