---
import Container from './Container.astro';
import Logo from './Logo.astro';
import NavList from './NavList.astro';
import { t, type Locale } from '../i18n/ui';
import { getAlternatePath, localizePath, currentPath } from '../i18n/utils';
import { navSections } from '../data/sections';

interface Props {
  locale: Locale;
  /**
   * Where the language switch should point when this page has no counterpart
   * in the other language — the 404, for instance, which exists only once.
   */
  alternateHref?: string;
}

const { locale, alternateHref } = Astro.props;
const tr = t(locale);
const alternate = getAlternatePath(Astro.url);

/** Locale-stripped and trailing-slash free, so it can be compared to a path. */
const here = currentPath(Astro.url);

/**
 * The full menu from the plan, minus the entries `sections.ts` marks
 * `hiddenFromNav` — `conditions`, whose page is still routed and still linked
 * to from the body map, the home page and every article breadcrumb. Every
 * entry that is here resolves.
 */
const navItems = [
  { path: '/', label: tr('nav.home') },
  ...navSections.map((section) => ({ path: section.path, label: section.nav[locale] })),
];
---

<header class="sticky top-0 z-50 border-b border-border bg-surface shadow-[var(--shadow-header)]">
  <Container>
    <div class="flex flex-wrap items-center gap-3 py-3">
      <a
        href={localizePath('/', locale)}
        class="flex min-w-0 items-center gap-2.5 no-underline"
        aria-label={tr('site.name')}
      >
        <Logo />
        <span class="leading-tight">
          <span class="block font-semibold text-ink">{tr('site.name')}</span>
          <span class="hidden text-[0.7rem] tracking-tight text-muted sm:block">{tr('brand.sub')}</span>
        </span>
      </a>

      <p class="mx-4 hidden flex-1 text-sm text-muted lg:block">{tr('brand.promise')}</p>

      {/*
        Icon-only on a narrow header, label from sm up. This is the only way
        into search on the site, so it must never disappear at any width — and
        because its text does, it carries a name of its own. That name starts
        with the same word the button shows, so a speech-control user asking
        for "ค้นหา" still hits it while the text is on screen.
      */}
      <a
        href={localizePath('/search', locale)}
        aria-label={tr('search.linkLabel')}
        class="ms-auto flex items-center gap-2 rounded-full bg-accent px-4 py-2.5 font-medium text-accent-contrast no-underline hover:opacity-90 sm:px-5 lg:ms-0"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          aria-hidden="true"
          class="shrink-0"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5" stroke-linecap="round"></path>
        </svg>
        <span class="hidden sm:inline">{tr('search.label')}</span>
      </a>

      <a
        href={alternateHref ?? alternate.path}
        hreflang={alternate.locale}
        aria-label={tr('lang.switchLabel')}
        class="shrink-0 whitespace-nowrap rounded-[6px] px-2 py-2 text-sm text-muted no-underline hover:text-ink"
      >
        {locale === 'th' ? 'TH | EN' : 'EN | TH'}
      </a>

      <button
        type="button"
        class="rounded-[6px] border border-border bg-ground px-3 py-2 text-ink md:hidden"
        aria-expanded="false"
        aria-controls="primary-nav"
        data-nav-toggle
      >
        {tr('nav.menu')}
      </button>
    </div>

    <nav id="primary-nav" aria-label={tr('a11y.mainNav')} class="hidden pb-2 md:block" data-nav>
      <NavList locale={locale} here={here} items={navItems} />
    </nav>

    {/*
      The no-JavaScript path.

      The menu above is collapsed below md and only a script can open it, so
      without one the site would have no navigation on a phone at all. This
      copy renders only when scripting is off — with it on, the parser treats
      everything in here as text, so there is no second set of links in the
      accessibility tree and none in the tab order.

      It is hidden from md up, where the real menu is a plain row and visible
      anyway; exactly one of the two is ever on screen.

      A <style> or an inline <script> would have been the tidier way to do
      this, and neither works here: our CSP hashes only the scripts and styles
      Astro itself generates, so an `is:inline` one is refused by the browser.
      <noscript> needs neither.
    */}
    <noscript>
      <nav aria-label={tr('a11y.mainNav')} class="pb-2 md:hidden">
        <NavList locale={locale} here={here} items={navItems} />
      </nav>
    </noscript>
  </Container>
</header>

<script>
  /**
   * An inline disclosure, not a modal: the page behind it stays interactive,
   * focus is not trapped, and a link inside it navigates normally — the menu
   * is closed on the next page because that page renders it closed.
   *
   * The button's `aria-expanded` is the state, and the nav's `hidden` class is
   * set in the same function, so what a screen reader is told and what is on
   * screen cannot drift apart.
   *
   * Resizing needs no handler: `hidden` is a below-md concern because the nav
   * also carries `md:block`, which wins from md up whatever the button last
   * said. Open on a phone, rotate to a tablet, come back — the state survives
   * and the desktop row is never affected.
   */
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  if (toggle && nav) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('hidden', !open);
    };

    /**
     * From md up the button is `display: none` and the menu is a plain row, so
     * there is nothing to open or close. `offsetParent` is null exactly then.
     */
    const isDisclosure = () => toggle.offsetParent !== null;

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !isDisclosure() || !isOpen()) return;

      // Escape hands focus back to the control that opened the menu — but only
      // when focus was inside the menu to begin with. Pressing Escape while
      // reading further down the page should not throw the caret up to the
      // header.
      const target = event.target;
      const inside = target instanceof Node && (nav.contains(target) || toggle.contains(target));

      setOpen(false);
      if (inside) toggle.focus();
    });
  }
</script>
