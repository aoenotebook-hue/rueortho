---
import Container from './Container.astro';
import Logo from './Logo.astro';
import { t, type Locale } from '../i18n/ui';
import { getAlternatePath, localizePath, stripLocale } from '../i18n/utils';
import { sections } from '../data/sections';

interface Props {
  locale: Locale;
  /**
   * Where the language switch should point when this page has no counterpart
   * in the other language — the 404, for instance, which exists only once.
   */
  alternateHref?: string;
}

const { locale, alternateHref } = Astro.props;
const tr = t(locale);
const alternate = getAlternatePath(Astro.url);
const here = stripLocale(Astro.url.pathname).replace(/\/$/, '') || '/';

/**
 * The full menu from the plan. Every entry resolves: sections still being
 * written render a stub that says so and points the reader somewhere useful,
 * which is better than a menu item that 404s or one that is missing entirely.
 */
const navItems = [
  { path: '/', label: tr('nav.home') },
  ...sections.map((section) => ({ path: section.path, label: section.nav[locale] })),
];
---

<header class="sticky top-0 z-50 border-b border-border bg-surface shadow-[var(--shadow-header)]">
  <Container>
    <div class="flex flex-wrap items-center gap-3 py-3">
      <a
        href={localizePath('/', locale)}
        class="flex min-w-0 items-center gap-2.5 no-underline"
        aria-label={tr('site.name')}
      >
        <Logo />
        <span class="leading-tight">
          <span class="block font-semibold text-ink">{tr('site.name')}</span>
          <span class="hidden text-[0.7rem] tracking-tight text-muted sm:block">{tr('brand.sub')}</span>
        </span>
      </a>

      <p class="mx-4 hidden flex-1 text-sm text-muted lg:block">{tr('brand.promise')}</p>

      <!-- Icon-only on a narrow header, label from sm up. One search entry
           point, so it must never disappear at any width. -->
      <a
        href={localizePath('/search', locale)}
        class="ms-auto flex items-center gap-2 rounded-full bg-accent px-4 py-2.5 font-medium text-accent-contrast no-underline hover:opacity-90 sm:px-5 lg:ms-0"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          aria-hidden="true"
          class="shrink-0"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5" stroke-linecap="round"></path>
        </svg>
        <span class="hidden sm:inline">{tr('search.label')}</span>
      </a>

      <a
        href={alternateHref ?? alternate.path}
        hreflang={alternate.locale}
        aria-label={tr('lang.switchLabel')}
        class="shrink-0 whitespace-nowrap rounded-[6px] px-2 py-2 text-sm text-muted no-underline hover:text-ink"
      >
        {locale === 'th' ? 'TH | EN' : 'EN | TH'}
      </a>

      <button
        type="button"
        class="rounded-[6px] border border-border bg-ground px-3 py-2 text-ink md:hidden"
        aria-expanded="false"
        aria-controls="primary-nav"
        data-nav-toggle
      >
        {tr('nav.menu')}
      </button>
    </div>

    <nav
      id="primary-nav"
      aria-label={tr('a11y.mainNav')}
      class="hidden pb-2 md:block"
      data-nav
    >
      <ul class="m-0 flex list-none flex-col gap-1 p-0 md:flex-row md:flex-wrap md:items-center md:gap-1">
        {
          navItems.map((item) => {
            const current = here === item.path;
            return (
              <li>
                <a
                  href={localizePath(item.path, locale)}
                  aria-current={current ? 'page' : undefined}
                  class:list={[
                    'block rounded-full px-4 py-2 text-[0.95em] no-underline',
                    current ? 'bg-brand-soft font-medium text-ink' : 'text-muted hover:text-ink',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </Container>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('hidden', open);
  });
</script>
