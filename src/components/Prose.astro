---
/** Typographic styles for rendered MDX. Slotted content is not scoped, so the
    rules below are global but namespaced under .prose. */
---

<div class="prose">
  <slot />
</div>

<style is:global>
  .prose {
    max-width: 68ch;
  }

  .prose > * + * {
    margin-top: 1.1em;
  }

  .prose h2 {
    margin-top: 2.2em;
    margin-bottom: 0.6em;
    padding-top: 0.3em;
    font-size: 1.5rem;
    scroll-margin-top: 5rem;
  }

  .prose h3 {
    margin-top: 1.8em;
    margin-bottom: 0.5em;
    font-size: 1.25rem;
    scroll-margin-top: 5rem;
  }

  .prose p,
  .prose li {
    color: var(--ink);
  }

  /* Tailwind's preflight removes list markers; patient content needs them back. */
  .prose ul,
  .prose ol {
    padding-inline-start: 1.4em;
  }

  .prose ul {
    list-style: disc;
  }

  .prose ol {
    list-style: decimal;
  }

  .prose li::marker {
    color: var(--muted);
  }

  .prose li + li {
    margin-top: 0.45em;
  }

  .prose li > ul,
  .prose li > ol {
    margin-top: 0.45em;
  }

  .prose strong {
    font-weight: 600;
  }

  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .prose blockquote {
    margin-inline: 0;
    padding-inline-start: 1.1em;
    border-inline-start: 3px solid var(--border);
    color: var(--muted);
  }

  .prose figure {
    margin-inline: 0;
  }

  .prose figcaption {
    margin-top: 0.6em;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .prose hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin-block: 2.5em;
  }

  /* Wide content scrolls inside its own container rather than the page. */
  .prose .table-wrapper,
  .prose pre {
    overflow-x: auto;
    max-width: 100%;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95em;
  }

  .prose th,
  .prose td {
    border: 1px solid var(--border);
    padding: 0.6em 0.8em;
    text-align: start;
    vertical-align: top;
  }

  .prose th {
    background: var(--ground);
    font-weight: 600;
  }

  .prose code {
    background: var(--ground);
    border-radius: 4px;
    padding: 0.15em 0.35em;
    font-size: 0.9em;
  }

  .prose pre {
    background: var(--ground);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 1em;
  }

  .prose pre code {
    background: none;
    padding: 0;
  }

  .prose img {
    border-radius: var(--radius-card);
  }
</style>
