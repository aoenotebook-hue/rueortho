---
/** Typographic styles for rendered MDX. Slotted content is not scoped, so the
    rules below are global but namespaced under .prose. */

interface Props {
  /**
   * Number the body's sections — `1.`, `1.1`, `1.2`, `2.` …
   *
   * On by default, and turned off for the legal and info pages, where the
   * sections are independent statements rather than steps a reader works
   * through in order.
   *
   * The numbers come from CSS counters rather than from the MDX, so no author
   * has to renumber anything when a section moves, and both languages are
   * numbered from the same source. `ArticleContents` computes the identical
   * numbering from `render()`'s headings, so the list and the page agree.
   */
  numbered?: boolean;
}

const { numbered = true } = Astro.props;
---

<div class:list={['prose', numbered && 'prose-numbered']}>
  <slot />
</div>

<style is:global>
  .prose {
    max-width: 68ch;
  }

  .prose > * + * {
    margin-top: 1.1em;
  }

  /*
     No `scroll-margin-top` here. `html { scroll-padding-top }` in global.css
     already holds every anchor target clear of the sticky header, and the two
     add up: a flat 5rem on top of the measured `--header-offset` put a heading
     a third of the way down the viewport, which reads as the wrong heading.
     One offset, in one place — see "Anchor offset" in CLAUDE.md.
  */
  /*
     Sizes are `em`, not `rem`. The base size lives on `body` in px and `rem`
     is the browser's 16px root, so rem headings did not scale with it: at the
     desktop 19px body an h2 of 1.5rem was 24px — 1.26x the paragraph around
     it, which does not read as a new section at a glance.
  */
  .prose h2 {
    margin-top: 2.6em;
    margin-bottom: 0.7em;
    padding-top: 1.1em;
    border-top: 1px solid var(--border);
    font-size: 1.5em;
  }

  .prose h3 {
    margin-top: 2em;
    margin-bottom: 0.5em;
    font-size: 1.2em;
  }

  /* ---------------------------------------------------------------------
     Numbered sections.

     Two levels, so a reader always knows which part of the article they are
     in and in what order the parts run. The section counter resets per
     article and the subsection counter per section, so moving a section
     renumbers everything below it with no edit to any MDX file.
     --------------------------------------------------------------------- */
  /*
     The child combinator is load-bearing. A markdown heading is a direct child
     of this div; a component's heading is not — `KeyFacts` renders an <h2>
     inside an <aside> and `ExerciseCard` an <h3> inside an <article>. As
     descendants they were counted too, so "สรุปสั้น ๆ" took number 1 and every
     real section was one out from the contents list beside it, and every
     exercise card claimed a subsection number of its own.
  */
  .prose-numbered {
    counter-reset: prose-section;
  }

  .prose-numbered > h2 {
    counter-reset: prose-subsection;
  }

  .prose-numbered > h2::before,
  .prose-numbered > h3::before {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .prose-numbered > h2::before {
    counter-increment: prose-section;
    content: counter(prose-section) '.';
    margin-inline-end: 0.5em;
  }

  .prose-numbered > h3::before {
    counter-increment: prose-subsection;
    content: counter(prose-section) '.' counter(prose-subsection);
    margin-inline-end: 0.5em;
  }

  /* An h3 is a step inside its section, so it is also indented from it. */
  .prose-numbered > h3 {
    padding-inline-start: 0.9em;
    border-inline-start: 3px solid var(--border);
  }

  .prose p,
  .prose li {
    color: var(--ink);
  }

  /* Tailwind's preflight removes list markers; patient content needs them back. */
  .prose ul,
  .prose ol {
    padding-inline-start: 1.4em;
  }

  .prose ul {
    list-style: disc;
  }

  .prose ol {
    list-style: decimal;
  }

  .prose li::marker {
    color: var(--muted);
  }

  .prose li + li {
    margin-top: 0.45em;
  }

  .prose li > ul,
  .prose li > ol {
    margin-top: 0.45em;
  }

  .prose strong {
    font-weight: 600;
  }

  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .prose blockquote {
    margin-inline: 0;
    padding-inline-start: 1.1em;
    border-inline-start: 3px solid var(--border);
    color: var(--muted);
  }

  /* ---------------------------------------------------------------------
     Figures.

     Two things make a picture read as belonging to the words above it: it
     sits closer to them than to whatever comes next, and it does not fill
     the column so completely that it becomes the page rather than an
     illustration of it.

     The spacing is asymmetric on purpose. A figure closes the section it
     illustrates, so it hugs the paragraph above and leaves a clear gap
     before the next heading — which now also carries a rule of its own.

     The cap is 34rem, the same width the article hero uses for a 4:3 scene.
     At 68ch the column runs to about 680px on a desktop, and a 1024px-wide
     illustration printed at that size dominates every sentence around it.
     Below ~544px the column is narrower than the cap and nothing changes.
     --------------------------------------------------------------------- */
  .prose figure {
    margin-inline: 0;
    margin-top: 1.25em;
    margin-bottom: 2.5em;
  }

  .prose figure img {
    max-width: min(34rem, 100%);
  }

  /* `.caption` in global.css carries the size; this only sets the spacing,
     so a figcaption written straight into markdown matches the components. */
  .prose figcaption {
    margin-top: 0.6em;
    font-size: 0.75em;
    line-height: 1.5;
    color: var(--muted);
  }

  .prose hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin-block: 2.5em;
  }

  /* Wide content scrolls inside its own container rather than the page. */
  .prose .table-wrapper,
  .prose pre {
    overflow-x: auto;
    max-width: 100%;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95em;
  }

  .prose th,
  .prose td {
    border: 1px solid var(--border);
    padding: 0.6em 0.8em;
    text-align: start;
    vertical-align: top;
  }

  .prose th {
    background: var(--ground);
    font-weight: 600;
  }

  .prose code {
    background: var(--ground);
    border-radius: 4px;
    padding: 0.15em 0.35em;
    font-size: 0.9em;
  }

  .prose pre {
    background: var(--ground);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 1em;
  }

  .prose pre code {
    background: none;
    padding: 0;
  }

  .prose img {
    border-radius: var(--radius-card);
  }
</style>
