---
import { Image } from 'astro:assets';
import bodyMap from '../assets/body-map.png';
import { t, type Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import { bodyMapRegions } from '../data/regions';

interface Props {
  locale: Locale;
  /** Published article count per region, so empty regions render inert. */
  counts: Record<string, number>;
}

const { locale, counts } = Astro.props;
const tr = t(locale);

/** Regions drawn on the left-hand figure, whose labels run out to the left. */
const LEFT_FIGURE = new Set(['shoulder', 'elbow', 'hand-wrist', 'hip', 'knee', 'foot-ankle']);

/**
 * The right-hand figure is the back view, and its two landmarks — the neck and
 * the spine — sit at x 71%, in the *middle* of a figure that spans 55–86%. A
 * label placed beside either dot therefore lies across the drawing: measured on
 * the artwork, the spine label crossed the torso edge at 76% and both arm lines
 * at 79–80% and 84–84.5%.
 *
 * Moving the dot is not an option — it is pointing at the spine. So the label
 * is pushed clear of the body and joined back to its dot with a leader line
 * (`.has-leader` in global.css). The left-hand figure needs none of this: its
 * dots are already on the outer edge and its labels run away from the body.
 */
const needsLeader = (id: string) => !LEFT_FIGURE.has(id);

/**
 * Where each region sits on the drawing. The artwork is two figures side by
 * side: the left one carries the limbs, the right one the neck and back.
 *
 * The percentages live in `global.css`, keyed off `data-region`, not in a
 * `style` attribute — our CSP hashes `<style>` elements but cannot cover
 * inline style attributes, so a positioned hotspot written that way would be
 * silently dropped by the browser and every dot would pile up in one corner.
 */
---

{/*
  34rem was too small for its own labels. The hotspots are 44px tall to meet the
  touch-target rule, but at 34rem the drawing is 363px high, so the 10% between
  elbow (40%), hand-wrist (50%) and hip (60%) is only 36.3px — the three tap
  targets on the left-hand figure overlapped each other by 8px, measured, at
  every width. The visible pills never touched; the clickable boxes did, which
  is a mis-tap rather than something you can see.

  At 44rem the drawing is 469px high and the same 10% is 46.9px, so the targets
  clear each other without a single coordinate moving — the percentages in
  global.css still point exactly where they were measured on the artwork's
  alpha channel. It also buys the room the longest label needs: "Hand & wrist"
  is 167px and reaches 57px to the left of the drawing, and from lg up the
  panel leaves at least 108px of slack on that side.
*/}
<div class="body-map relative mx-auto max-w-[44rem]">
  {/*
    Decorative: the drawing shows a body front and back, and every piece of
    information a reader needs is in the labelled links on top of it. Giving it
    a description as well would just make a screen reader read the same eight
    region names twice.
  */}
  <Image
    src={bodyMap}
    alt=""
    widths={[600, 900, 1200]}
    sizes="(min-width: 1024px) 44rem, 100vw"
    loading="lazy"
    decoding="async"
    class="body-map-figure w-full"
  />

  {
    bodyMapRegions.map((region) => {
      const count = counts[region.id] ?? 0;
      const label = region.label[locale];

      // A region with nothing published is shown, but inert — a dot that leads
      // to an empty page is worse than a dot that plainly says "not yet".
      if (count === 0) {
        return (
          <span
            class:list={[
              'body-map-hotspot',
              'is-empty',
              LEFT_FIGURE.has(region.id) && 'to-left',
              needsLeader(region.id) && 'has-leader',
            ]}
            data-region={region.id}
            title={tr('common.comingSoon')}
          >
            <span class="body-map-dot" aria-hidden="true" />
            <span class="body-map-label">{label}</span>
          </span>
        );
      }

      return (
        <a
          class:list={[
            'body-map-hotspot',
            LEFT_FIGURE.has(region.id) && 'to-left',
            needsLeader(region.id) && 'has-leader',
          ]}
          data-region={region.id}
          href={localizePath(`/regions/${region.id}`, locale)}
        >
          <span class="body-map-dot" aria-hidden="true" />
          <span class="body-map-label">{label}</span>
        </a>
      );
    })
  }
</div>
