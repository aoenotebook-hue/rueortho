---
import { Image } from 'astro:assets';
import bodyMap from '../assets/body-map.png';
import { t, type Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import { bodyMapRegions } from '../data/regions';

interface Props {
  locale: Locale;
  /** Published article count per region, so empty regions render inert. */
  counts: Record<string, number>;
}

const { locale, counts } = Astro.props;
const tr = t(locale);

/** Regions drawn on the left-hand figure, whose labels run out to the left. */
const LEFT_FIGURE = new Set(['shoulder', 'elbow', 'hand-wrist', 'hip', 'knee', 'foot-ankle']);

/**
 * The right-hand figure is the back view, and its two landmarks — the neck and
 * the spine — sit at x 71%, in the *middle* of a figure that spans 55–86%. A
 * label placed beside either dot therefore lies across the drawing: measured on
 * the artwork, the spine label crossed the torso edge at 76% and both arm lines
 * at 79–80% and 84–84.5%.
 *
 * Moving the dot is not an option — it is pointing at the spine. So the label
 * is pushed clear of the body and joined back to its dot with a leader line
 * (`.has-leader` in global.css). The left-hand figure needs none of this: its
 * dots are already on the outer edge and its labels run away from the body.
 */
const needsLeader = (id: string) => !LEFT_FIGURE.has(id);

/**
 * Where each region sits on the drawing. The artwork is two figures side by
 * side: the left one carries the limbs, the right one the neck and back.
 *
 * The percentages live in `global.css`, keyed off `data-region`, not in a
 * `style` attribute — our CSP hashes `<style>` elements but cannot cover
 * inline style attributes, so a positioned hotspot written that way would be
 * silently dropped by the browser and every dot would pile up in one corner.
 */
---

{/*
  The drawing is sized per breakpoint, because the tablet is the tight case and
  everything on the map is measured against it.

  A hotspot has to be tall enough to tap and the labels have to stay inside the
  panel, and at a fixed 34rem neither held: the drawing was 363px high, so the
  10% between elbow (40%), hand-wrist (50%) and hip (60%) was 36.3px against a
  44px target, and the three tap targets on the left figure overlapped by 8px at
  every width in both languages. The visible pills never touched, so nothing
  looked wrong — only the clickable boxes did.

  Widening the drawing spreads those percentages apart, but a wider drawing has
  less room beside it for the labels that flow outwards, and the two pull
  against each other. At 768px the panel is 664px wide and the longest label
  ("Hand & wrist", 167px) reaches 74px left of the drawing, so the drawing
  cannot exceed about 36rem there; at 44rem it would push that label off the
  side of the screen. From lg the panel is at least 920px and 44rem fits with
  room to spare.

  So: 36rem at md and 44rem at lg, with `--body-map-leader` scaled to match in
  global.css. Not one coordinate moves — the percentages still point exactly
  where they were measured on the artwork's alpha channel.

  **From lg this is clean: no overlap, nothing outside the panel. At md a small
  overlap remains** — measured 5-6px in Thai and 3px in English between elbow,
  hand-wrist and hip, down from 8px before. 36rem gives those three 38.4px of
  separation, and a hotspot is ~44px tall in Thai and ~41px in English because
  the pill is a line box plus padding. Closing the last few pixels would mean
  either a wider drawing, which 768px cannot hold without pushing "Hand &
  wrist" off the side, or smaller label text, which this audience is the last
  one to spend. The overlap sits in the hotspot's transparent padding and never
  in the visible pill, so a reader aiming at a label always gets that label; it
  only decides taps in the blank space between two of them. If that trade is
  ever judged the wrong way round, moving the map back to lg removes it
  entirely and the circle grid covers the tablet perfectly well.
*/}
<div class="body-map relative mx-auto max-w-[36rem] lg:max-w-[44rem]">
  {/*
    Decorative: the drawing shows a body front and back, and every piece of
    information a reader needs is in the labelled links on top of it. Giving it
    a description as well would just make a screen reader read the same eight
    region names twice.
  */}
  <Image
    src={bodyMap}
    alt=""
    widths={[600, 900, 1200]}
    sizes="(min-width: 1024px) 44rem, (min-width: 768px) 36rem, 100vw"
    loading="lazy"
    decoding="async"
    class="body-map-figure w-full"
  />

  {
    bodyMapRegions.map((region) => {
      const count = counts[region.id] ?? 0;
      const label = region.label[locale];

      // A region with nothing published is shown, but inert — a dot that leads
      // to an empty page is worse than a dot that plainly says "not yet".
      if (count === 0) {
        return (
          <span
            class:list={[
              'body-map-hotspot',
              'is-empty',
              LEFT_FIGURE.has(region.id) && 'to-left',
              needsLeader(region.id) && 'has-leader',
            ]}
            data-region={region.id}
            title={tr('common.comingSoon')}
          >
            <span class="body-map-dot" aria-hidden="true" />
            <span class="body-map-label">{label}</span>
          </span>
        );
      }

      return (
        <a
          class:list={[
            'body-map-hotspot',
            LEFT_FIGURE.has(region.id) && 'to-left',
            needsLeader(region.id) && 'has-leader',
          ]}
          data-region={region.id}
          href={localizePath(`/regions/${region.id}`, locale)}
        >
          <span class="body-map-dot" aria-hidden="true" />
          <span class="body-map-label">{label}</span>
        </a>
      );
    })
  }
</div>
