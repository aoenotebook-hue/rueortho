---
import type { MarkdownHeading } from 'astro';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Straight from `await render(entry)` — never parsed out of the body. */
  headings: MarkdownHeading[];
}

const { locale, headings } = Astro.props;
const tr = t(locale);

/**
 * Astro gives every markdown heading an id and hands the same list back from
 * `render()`, so the contents are built from what the page actually rendered.
 * Nothing here reads the MDX source: a regex over Markdown would miss the
 * slugger's own rules — Thai text keeps its characters, spaces become hyphens,
 * and a repeated title gets a `-1` suffix — and the two would drift the first
 * time an author wrote a heading the regex did not expect.
 *
 * Only the article body is listed. The FAQ, references, companion apps and
 * related-articles blocks below it come from the renderer rather than the MDX,
 * carry no ids, and are appendices to the article rather than parts of it.
 *
 * h2 is the outline. An h3 is listed only where its parent h2 has **at least
 * two** of them: a section with a single subheading is not something a reader
 * needs help navigating, while the ACL article's twelve-part recovery section
 * is exactly what a contents list is for.
 */
const sections: { heading: MarkdownHeading; children: MarkdownHeading[] }[] = [];

for (const heading of headings) {
  if (heading.depth === 2) {
    sections.push({ heading, children: [] });
  } else if (heading.depth === 3) {
    sections.at(-1)?.children.push(heading);
  }
}

/**
 * The same numbering the page itself shows.
 *
 * `Prose` numbers the body with CSS counters — `1.`, `1.1`, `2.` — and the
 * two have to agree, or the list sends a reader looking for "3." at a heading
 * called something else. They are computed from one list of headings here and
 * incremented on the same rule there: every h2 counts, and every h3 counts
 * within its h2, whether or not this list ends up showing it.
 */
const items = sections.flatMap(({ heading, children }, sectionIndex) => [
  { heading, number: `${sectionIndex + 1}.` },
  ...(children.length >= 2
    ? children.map((child, childIndex) => ({
        heading: child,
        number: `${sectionIndex + 1}.${childIndex + 1}`,
      }))
    : []),
]).filter((item) => item.heading.slug);

/**
 * A contents list shorter than three entries is a list of the two things
 * already on screen. The caller renders nothing at all in that case.
 */
const worthShowing = items.length >= 3;
---

{
  worthShowing && (
    <details
      class="article-contents mt-8 rounded-[10px] border border-border bg-surface px-4 py-3"
      data-article-contents
      data-pagefind-ignore
    >
      {/*
        From 1360px up this same element becomes a sticky rail in the right
        gutter — see `.article-contents` in global.css. It is styling only: the
        markup, the DOM order and the accessibility tree are identical at every
        width, so there is no second copy to drift and nothing a narrow screen
        has to skip past. The rail's width is computed from the gutter the
        reading column actually leaves, not from a fixed number, because that
        column is 68ch and `ch` depends on which font loaded.
      */}
      {/*
        One element for both widths. It opens itself from md up — see the
        script — so a phone gets a closed, compact disclosure and a desktop
        gets a plain list with a heading. Without JavaScript it stays closed
        everywhere, which is still a working control rather than hidden
        content: the CSS that would flip it instead is the kind our CSP
        refuses, and forcing a closed <details> open from a stylesheet is not
        reliable across browsers anyway.
      */}
      <summary class="cursor-pointer font-medium text-ink">{tr('article.onThisPage')}</summary>

      <nav aria-label={tr('article.onThisPage')} class="mt-3">
        {/* Two columns from md up: a long outline should not push the article
            it belongs to off the screen. */}
        <ol class="article-contents-list m-0 list-none p-0 text-[0.95em] md:columns-2 md:gap-8">
          {items.map(({ heading, number }) => (
            <li class:list={['break-inside-avoid', heading.depth === 3 && 'ps-4']}>
              <a
                href={`#${heading.slug}`}
                data-toc-link={heading.slug}
                class:list={[
                  'flex gap-2 py-1.5 no-underline hover:underline',
                  heading.depth === 3 ? 'text-muted' : 'text-ink',
                ]}
              >
                <span class="shrink-0 tabular-nums text-accent">{number}</span>
                <span class="min-w-0">{heading.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}

<script>
  /**
   * The contents list is a disclosure on a phone and a plain list on a desktop,
   * and `open` is an attribute rather than something CSS can set — so this
   * mirrors the media query onto it.
   *
   * It only ever sets the state the width implies, so a reader who closes it on
   * a desktop gets it closed until the width changes. Nothing is stored; the
   * next page starts from the width again.
   */
  const contents = document.querySelector<HTMLDetailsElement>('[data-article-contents]');

  if (contents) {
    const wide = window.matchMedia('(min-width: 768px)');
    const sync = () => {
      contents.open = wide.matches;
    };

    sync();
    wide.addEventListener('change', sync);

    /**
     * Scroll-spy: mark the section the reader is currently in.
     *
     * This is what makes a rail that follows the reader worth having. Without
     * it the list says where you can go but never where you are, which on a
     * twelve-section article is the question a reader actually has.
     *
     * The targets are found by the ids already in the list's own hrefs, so the
     * spy and the links cannot disagree about a slug — the same reason the
     * list is built from `render()`'s headings rather than from the MDX.
     *
     * It reads the scroll position rather than using IntersectionObserver. The
     * rule wanted is "the last heading whose top has passed under the sticky
     * header", which is the heading `scroll-padding-top` just landed the
     * reader on. An observer answers a different question — which headings are
     * visible — and gets it wrong for a long section whose heading has already
     * scrolled away.
     */
    const links = new Map<string, HTMLAnchorElement>();
    for (const link of contents.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')) {
      links.set(link.dataset.tocLink!, link);
    }

    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    if (targets.length > 0) {
      let current: HTMLAnchorElement | null = null;
      let queued = false;

      const mark = () => {
        queued = false;

        // The offset the browser itself uses for an anchor jump, plus a pixel
        // so a heading sitting exactly on the line counts as reached.
        const offset =
          parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;

        let active: HTMLElement | null = null;
        for (const target of targets) {
          if (target.getBoundingClientRect().top <= offset + 1) active = target;
          else break;
        }

        // Past the last heading it stays marked; above the first one nothing
        // is, because the reader is still in the summary.
        const next = active ? links.get(active.id) ?? null : null;
        if (next === current) return;

        current?.removeAttribute('aria-current');
        current?.classList.remove('is-current');
        next?.setAttribute('aria-current', 'true');
        next?.classList.add('is-current');
        current = next;
      };

      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(mark);
      };

      mark();
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });
    }
  }
</script>
