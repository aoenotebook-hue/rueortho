---
import Container from './Container.astro';
import Callout from './Callout.astro';
import { t, type Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import { getAuthor, byline } from '../data/authors';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const author = getAuthor('sorawut');

const copy = {
  th: {
    intro:
      'เว็บไซต์นี้จัดทำขึ้นเพื่อให้ประชาชนทั่วไปเข้าใจโรคและภาวะทางกระดูก ข้อ และกล้ามเนื้อที่พบบ่อย ด้วยภาษาที่อ่านเข้าใจง่าย',
    forWho: 'เว็บไซต์นี้เหมาะกับใคร',
    forWhoBody:
      'สำหรับผู้ที่มีอาการและอยากเข้าใจว่าเกิดอะไรขึ้นกับร่างกายของตนเอง ผู้ที่เพิ่งได้รับการวินิจฉัยและอยากรู้ว่าจะเกิดอะไรขึ้นต่อไป และผู้ดูแลที่ต้องการช่วยคนในครอบครัว เราเขียนโดยคิดถึงผู้อ่านที่อ่านจากโทรศัพท์มือถือ และไม่มีพื้นฐานทางการแพทย์มาก่อน',
    notDo: 'สิ่งที่เว็บไซต์นี้ไม่ได้ทำ',
    notDoItems: [
      'ไม่ให้คำแนะนำทางการแพทย์เฉพาะบุคคล และไม่วินิจฉัยโรคให้ท่าน',
      'ไม่รับนัดหมาย ไม่ให้คำปรึกษาเป็นรายบุคคล และไม่ตอบคำถามเกี่ยวกับอาการของท่านทางอีเมล',
      'ไม่โฆษณา ไม่แนะนำสถานพยาบาล ผลิตภัณฑ์ หรืออาหารเสริมใด ๆ',
    ],
    howWritten: 'บทความเขียนอย่างไร',
    howWrittenBody:
      'บทความทุกชิ้นเขียนและตรวจทานโดยศัลยแพทย์ออร์โธปิดิกส์ ระบุชื่อผู้เขียน ผู้ตรวจทาน วันที่เผยแพร่ และวันที่ตรวจทานล่าสุดไว้ที่ต้นบทความ พร้อมรายการอ้างอิงท้ายบทความ และจะได้รับการทบทวนอย่างน้อยทุก 24 เดือน',
  },
  en: {
    intro:
      'This site exists to help the general public understand common bone, joint and muscle problems, in language that is easy to read.',
    forWho: 'Who this site is for',
    forWhoBody:
      'For people with symptoms who want to understand what is happening in their body, people who have just been diagnosed and want to know what comes next, and family members helping someone else. It is written for a reader on a phone with no medical background.',
    notDo: 'What this site does not do',
    notDoItems: [
      'It does not give personal medical advice and cannot diagnose you.',
      'It does not take appointments, give individual consultations, or answer questions about your symptoms by e-mail.',
      'It carries no advertising and recommends no hospital, clinic, product or supplement.',
    ],
    howWritten: 'How the articles are written',
    howWrittenBody:
      'Every article is written and reviewed by an orthopaedic surgeon. The author, the reviewer, the publication date and the last review date appear at the top of each article, with references at the end. Articles are re-reviewed at least every 24 months.',
  },
} as const;

const c = copy[locale];
---

<Container width="prose">
  <div class="py-10">
    <h1>{tr('nav.about')}</h1>
    <p class="text-lg text-muted">{tr('site.tagline')}</p>
    <p>{c.intro}</p>

    <h2>{c.forWho}</h2>
    <p>{c.forWhoBody}</p>

    <h2>{c.notDo}</h2>
    <ul class="list-disc ps-5">
      {c.notDoItems.map((item) => <li class="mt-2">{item}</li>)}
    </ul>

    <h2>{c.howWritten}</h2>
    <p>{c.howWrittenBody}</p>

    <h2>{tr('home.aboutAuthor')}</h2>
    <p class="m-0 font-semibold">{byline(author, locale)}</p>
    <p class="mt-2">{author.bio[locale][0]}</p>
    <p>
      <a href={localizePath(`/about/author/${author.id}`, locale)}>{tr('home.readAuthor')}</a>
    </p>

    <Callout type="warning">{tr('footer.disclaimer')}</Callout>
  </div>
</Container>
